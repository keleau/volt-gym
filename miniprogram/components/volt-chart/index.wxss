.vchart {
  position: relative;
  width: 100%;
  overflow: hidden;
}

.vchart__canvas {
  display: block;
  width: 100%;
  height: 100%;
}

.vchart__empty {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: "Plex Mono", Consolas, monospace;
  font-size: 22rpx;
  letter-spacing: 0.14em;
  color: #b3aa9c;
  pointer-events: none;
}
