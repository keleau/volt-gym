.vb {
  padding-top: 4rpx;
  color: #1b1712;
}

.vb-form {
  padding-bottom: 8rpx;
}

.vb-field {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-bottom: 22rpx;
}

.vb-label {
  font-size: 24rpx;
  font-weight: 600;
  color: #1b1712;
}

.vb-phone-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.vb-input {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  padding: 0 20rpx;
  border: 1rpx solid #c6b69e;
  border-radius: 0;
  background: #ffffff;
  font-size: 28rpx;
}

.vb-placeholder {
  color: #a89982;
  font-size: 25rpx;
}

.vb-code-btn {
  flex: none;
  height: 88rpx;
  padding: 0 18rpx;
  background: #1b1712;
  color: #fbf5e9;
  font-size: 23rpx;
  line-height: 88rpx;
  text-align: center;
}

.vb-code-btn[disabled] {
  opacity: 0.55;
}

.vb-dev {
  display: block;
  margin: -4rpx 0 16rpx;
  font-size: 20rpx;
  color: #873023;
}

.vb-error {
  display: block;
  margin: 0 0 16rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #873023;
}

.vb-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100% !important;
  min-height: 86rpx;
  margin-top: 12rpx;
  padding: 0 24rpx;
  border: 1rpx solid transparent;
  border-radius: 3rpx;
  font-size: 29rpx;
  font-weight: 600;
  line-height: 1.2;
  text-align: center;
}

.vb-btn--primary {
  background: #a33b2b;
  border-color: #a33b2b;
  color: #fbf5e9;
}

.vb-btn--ghost {
  background: #fbf5e9;
  border-color: #cfc0a9;
  color: #1b1712;
}

.vb-btn[disabled] {
  opacity: 0.55;
}

.vb-submit {
  margin-top: 8rpx;
}

.vb-note {
  display: block;
  margin-top: 16rpx;
  font-size: 20rpx;
  line-height: 1.6;
  color: #72654f;
}

.vb-result {
  padding: 4rpx 0 8rpx;
}

.vb-stamp {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 126rpx;
  min-height: 62rpx;
  padding: 0 16rpx;
  border: 2rpx solid #a33b2b;
  background: rgba(253, 249, 240, 0.72);
  color: #a33b2b;
  font-size: 22rpx;
  letter-spacing: 0.08em;
  transform: rotate(-5deg);
}

.vb-result--trial .vb-stamp {
  border-color: #66705b;
  color: #56604c;
}

.vb-result--visitor .vb-stamp {
  border-color: #1b1712;
  color: #1b1712;
}

.vb-result--pending .vb-stamp {
  border-color: #873023;
  color: #873023;
}

.vb-lead {
  display: block;
  margin-top: 20rpx;
  font-size: 27rpx;
  line-height: 1.65;
  color: #635846;
}

.vb-rows {
  margin: 24rpx 0 8rpx;
  border-top: 1rpx solid #d9cbb6;
}

.vb-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 22rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx dashed #e2d5c2;
}

.vb-row__label {
  flex: none;
  padding-top: 3rpx;
  font-size: 20rpx;
  color: #8b7e68;
}

.vb-row__value {
  flex: 1;
  text-align: right;
  font-size: 25rpx;
  line-height: 1.5;
  color: #1b1712;
  word-break: break-all;
}

.vb-text-btn {
  display: block;
  width: 100% !important;
  margin-top: 16rpx !important;
  padding: 10rpx 0;
  color: #72654f;
  font-size: 23rpx;
  line-height: 1.4;
  text-align: center;
}

.vb-safe {
  height: calc(24rpx + env(safe-area-inset-bottom));
}
