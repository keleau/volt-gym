<view class="page mine">
  <volt-nav placeholder="{{false}}" title="我的"></volt-nav>

  <scroll-view
    class="mine-scroll"
    scroll-y
    enhanced
    show-scrollbar="{{false}}"
    scroll-top="{{scrollTop}}"
    refresher-enabled
    refresher-triggered="{{refreshing}}"
    refresher-threshold="80"
    refresher-background="#F8F2E6"
    refresher-default-style="dark"
    bindrefresherrefresh="onRefresh"
  >
    <view style="height:{{nav.totalHeight}}px"></view>

    <view wx:if="{{loading}}" class="loading"><view class="loading__bar"></view><text>正在加载</text></view>

    <block wx:else>
      <view class="mine-profile wrap">
        <view class="mine-kicker mono"><view class="mine-kicker__node"></view>VOLT / MEMBER LOG · 我的档案</view>
        <view class="mine-profile__card card" bindtap="onGoProfile" hover-class="mine-profile__card--hover">
          <view class="mine-avatar" catchtap="onChangeAvatar">
            <view class="mine-profile__avatar">
              <image wx:if="{{avatarPreview || member.avatarUrl}}" class="mine-profile__img" src="{{avatarPreview || member.avatarUrl}}" mode="aspectFill"></image>
              <text wx:else>{{memberInitial}}</text>
            </view>
            <view class="mine-avatar__edit">{{avatarUploading ? '…' : '换'}}</view>
          </view>
          <view class="mine-profile__main">
            <text class="mine-profile__name">{{member.nickname}}</text>
            <text class="mine-profile__meta">{{member.goal}} · 会员 {{member.joinedAt}}</text>
          </view>
          <view wx:if="{{sessionMode === 'wechat'}}" class="mine-profile__switch" catchtap="openSwitcher">
            <text>{{members.length > 1 ? '切换卡' : '添加卡'}}</text>
          </view>
          <text class="mine-profile__arrow">›</text>
        </view>
      </view>

      <view class="mine-group wrap">
        <view class="menu card">
          <view class="menu-row" bindtap="onGoBookings" data-tab="upcoming" hover-class="menu-row--hover">
            <text class="menu-row__label">我的预约</text>
            <view class="menu-row__right">
              <text wx:if="{{counts.upcoming}}" class="menu-row__badge">{{counts.upcoming}}</text>
              <text class="menu-row__arrow">›</text>
            </view>
          </view>
          <view class="menu-row" bindtap="onGoMessages" hover-class="menu-row--hover">
            <text class="menu-row__label">消息中心</text>
            <view class="menu-row__right">
              <text wx:if="{{messagesUnread}}" class="menu-row__badge menu-row__badge--accent">{{messagesUnread}}</text>
              <text class="menu-row__arrow">›</text>
            </view>
          </view>
          <view class="menu-row" bindtap="goPass" hover-class="menu-row--hover">
            <text class="menu-row__label">会员卡</text>
            <view class="menu-row__right">
              <text wx:if="{{pendingCard}}" class="menu-row__desc">待开卡</text>
              <text wx:elif="{{member.credits > 0}}" class="menu-row__desc">余 {{member.credits}} 次</text>
              <text wx:else class="menu-row__desc">未开通</text>
              <text class="menu-row__arrow">›</text>
            </view>
          </view>
          <view class="menu-row" bindtap="goBuyPass" hover-class="menu-row--hover">
            <text class="menu-row__label">购买会员卡</text>
            <view class="menu-row__right">
              <text class="menu-row__desc">10 次卡 ¥899</text>
              <text class="menu-row__arrow">›</text>
            </view>
          </view>
        </view>
      </view>

      <view class="mine-group wrap">
        <view class="menu card">
          <view class="menu-row" bindtap="openReminders" hover-class="menu-row--hover">
            <text class="menu-row__label">微信提醒</text>
            <view class="menu-row__right">
              <text class="menu-row__desc">{{subscriptions.classReminder ? '已开启' : '已关闭'}}</text>
              <text class="menu-row__arrow">›</text>
            </view>
          </view>
          <button class="menu-row menu-row--button" open-type="share" hover-class="menu-row--hover">
            <text class="menu-row__label">邀请好友</text>
            <view class="menu-row__right">
              <text class="menu-row__desc">已邀请 {{invites.invitedCount}} 人</text>
              <text class="menu-row__arrow">›</text>
            </view>
          </button>
          <view class="menu-row" bindtap="onGoVenues" hover-class="menu-row--hover">
            <text class="menu-row__label">门店与客服</text>
            <view class="menu-row__right">
              <text class="menu-row__desc">广州三店</text>
              <text class="menu-row__arrow">›</text>
            </view>
          </view>
          <view class="menu-row" bindtap="onContact" hover-class="menu-row--hover">
            <text class="menu-row__label">联系客服</text>
            <view class="menu-row__right">
              <text class="menu-row__desc">{{brand.phone}}</text>
              <text class="menu-row__arrow">›</text>
            </view>
          </view>
          <view class="menu-row" bindtap="onAbout" hover-class="menu-row--hover">
            <text class="menu-row__label">关于 VOLT</text>
            <view class="menu-row__right">
              <text class="menu-row__arrow">›</text>
            </view>
          </view>
          <view wx:if="{{sessionMode === 'wechat'}}" class="menu-row" bindtap="onOpenLogin" hover-class="menu-row--hover">
            <text class="menu-row__label">微信授权</text>
            <view class="menu-row__right">
              <text class="menu-row__desc">已接入 · 更新资料</text>
              <text class="menu-row__arrow">›</text>
            </view>
          </view>
          <view class="menu-row" bindtap="openPhoneBind" hover-class="menu-row--hover">
            <text class="menu-row__label">绑定手机号</text>
            <view class="menu-row__right">
              <text class="menu-row__desc">{{member.phoneBound ? member.phone : '未绑定'}}</text>
              <text class="menu-row__arrow">›</text>
            </view>
          </view>
        </view>
      </view>

      <view class="mine-group wrap">
        <view class="menu card">
          <view class="menu-row menu-row--danger" bindtap="onLogout" hover-class="menu-row--hover">
            <text class="menu-row__label">退出登录</text>
            <view class="menu-row__right">
              <text class="menu-row__desc">可切换账号</text>
              <text class="menu-row__arrow">›</text>
            </view>
          </view>
        </view>
      </view>

      <view class="mine-bottom"></view>
    </block>
  </scroll-view>

  <volt-sheet
    visible="{{reminderVisible}}"
    title="微信提醒"
    subtitle="通过微信服务通知送达"
    maxHeight="70vh"
    bind:close="closeReminders"
  >
    <view class="push">
      <view class="push-row">
        <view class="push-row__main">
          <text class="push-row__title">开课提醒</text>
          <text class="push-row__desc">开课前 60 分钟提醒</text>
        </view>
        <switch checked="{{subscriptions.classReminder}}" color="#A33B2B" data-key="classReminder" bindchange="onToggleSub" />
      </view>
      <view class="push-row">
        <view class="push-row__main">
          <text class="push-row__title">课程变更</text>
          <text class="push-row__desc">时间、教练或门店调整时推送</text>
        </view>
        <switch checked="{{subscriptions.classChange}}" color="#A33B2B" data-key="classChange" bindchange="onToggleSub" />
      </view>
      <view class="push-row">
        <view class="push-row__main">
          <text class="push-row__title">候补递补</text>
          <text class="push-row__desc">候补出现空位时提醒</text>
        </view>
        <switch checked="{{subscriptions.waitlist}}" color="#A33B2B" data-key="waitlist" bindchange="onToggleSub" />
      </view>
      <text class="push-note">课程变更属于重要通知，建议保持开启。</text>
      <view class="push-safe"></view>
    </view>
  </volt-sheet>

  <volt-sheet
    visible="{{switcherVisible}}"
    title="会员卡"
    subtitle="同一个微信下的会员档案"
    maxHeight="72vh"
    bind:close="closeSwitcher"
  >
    <view class="member-switch">
      <view
        wx:for="{{members}}"
        wx:key="id"
        class="member-switch__row {{item.id === member.id ? 'is-active' : ''}}"
        data-id="{{item.id}}"
        bindtap="onSwitchMember"
      >
        <view class="member-switch__avatar">{{item.avatarText || '电'}}</view>
        <view class="member-switch__main">
          <text class="member-switch__name">{{item.nickname || 'VOLT 会员'}}</text>
          <text class="member-switch__meta">{{item.phone || '未绑定手机号'}} · {{item.credits}} 次</text>
        </view>
        <text class="member-switch__tag">{{item.id === member.id ? '当前' : (switchingId === item.id ? '切换中…' : '切换')}}</text>
      </view>

      <button class="btn btn--ghost btn--block member-switch__add" bindtap="onAddMember">添加会员卡</button>
      <text class="member-switch__note">同一手机号始终是同一张会员卡；不同手机号是不同会员档案，次数与流水独立。</text>
      <view class="member-switch__safe"></view>
    </view>
  </volt-sheet>

  <volt-login
    visible="{{loginVisible}}"
    bind:success="onLoginSuccess"
    bind:cancel="onLoginCancel"
  ></volt-login>
</view>
