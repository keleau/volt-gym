}

.mine-pass__bar::after {
  content: "";
  position: absolute;
  inset: 0;
  background-image: linear-gradient(90deg, rgba(27, 23, 18, 0.2) 2rpx, transparent 2rpx);
  background-size: 10% 100%;
}

.mine-group {
