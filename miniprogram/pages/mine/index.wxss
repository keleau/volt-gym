.mine {
  height: 100vh;
  overflow: hidden;
  background: #f8f2e6;
}

.mine-scroll {
  width: 100%;
  height: 100vh;
}

.mine-profile {
  padding-top: 18rpx;
}

.mine-profile__card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 22rpx;
}

.mine-profile__card--hover {
  background: #fbf5e9;
}

.mine-profile__avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #f0ddd6;
  color: #873023;
  font-size: 36rpx;
  font-weight: 700;
  flex: none;
  overflow: hidden;
}

.mine-profile__img {
  width: 96rpx;
  height: 96rpx;
}

.mine-profile__main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.mine-profile__name {
  font-size: 34rpx;
  font-weight: 800;
  letter-spacing: -0.03em;
}

.mine-profile__meta {
  font-size: 23rpx;
  color: #635846;
}

.mine-profile__arrow {
  font-size: 36rpx;
  line-height: 1;
  color: #8b7e68;
  flex: none;
}

.mine-pass {
  margin-top: 14rpx;
}

.mine-pass__card {
  padding: 24rpx;
  background: #fbf5e9;
  border-color: #dfc3b9;
  box-shadow: none;
}

.mine-pass__card--hover {
  background: #f0ddd6;
}

.mine-pass__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.mine-pass__brand {
  font-family: "Source Han Serif SC", "Noto Serif CJK SC", "Songti SC", "STSong", "SimSun", serif;
  font-size: 30rpx;
  line-height: 1;
  color: #1b1712;
}

.mine-pass__slash {
  color: #a33b2b;
  letter-spacing: -0.14em;
  margin-left: 2rpx;
  transform: skewX(-8deg);
}

.mine-pass__link {
  font-size: 23rpx;
  color: #873023;
}

.mine-pass__body {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 14rpx;
}

.mine-pass__credits {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
}

.mine-pass__num {
  font-family: "Source Han Serif SC", "Noto Serif CJK SC", "Songti SC", "STSong", "SimSun", serif;
  font-size: 70rpx;
  line-height: 0.9;
  color: #1b1712;
}

.mine-pass__unit {
  font-size: 24rpx;
  color: #635846;
}

.mine-pass__info {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 2rpx;
}

.mine-pass__plan {
  font-size: 24rpx;
  font-weight: 600;
  color: #3c342a;
}

.mine-pass__expire {
  font-size: 22rpx;
  color: #873023;
  opacity: 0.7;
}

.mine-pass__bar {
  height: 6rpx;
  margin-top: 16rpx;
  border-radius: 4rpx;
  background: rgba(163, 59, 43, 0.16);
  overflow: hidden;
}

.mine-pass__fill {
  height: 100%;
  border-radius: 4rpx;
  background: #a33b2b;
}

.mine-group {
  margin-top: 20rpx;
}

.menu {
  overflow: hidden;
}

.menu-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  width: 100% !important;
  padding: 20rpx 22rpx;
  border-bottom: 1rpx solid #ece0ce;
  background: transparent;
  text-align: left;
}

.menu-row:last-child {
  border-bottom: 0;
}

.menu-row--hover {
  background: #fbf5e9;
}

.menu-row--button {
  line-height: inherit;
}

.menu-row__label {
  font-size: 28rpx;
  font-weight: 500;
  color: #1b1712;
  flex: none;
}

.menu-row__right {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}

.menu-row__desc {
  font-size: 23rpx;
  color: #635846;
  text-align: right;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.menu-row__badge {
  min-width: 34rpx;
  height: 32rpx;
  padding: 0 8rpx;
  border-radius: 4rpx;
  background: #f8f2e6;
  color: #635846;
  font-size: 22rpx;
  line-height: 32rpx;
  text-align: center;
}

.menu-row__badge--accent {
  background: #a33b2b;
  color: #1b1712;
}

.menu-row__arrow {
  font-size: 34rpx;
  line-height: 1;
  color: #8b7e68;
  flex: none;
}

.mine-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 28rpx;
  font-size: 23rpx;
  color: #8b7e68;
}

.mine-foot__reset {
  color: #8b7e68;
  text-decoration: underline;
  text-decoration-color: #d9d1c4;
  text-underline-offset: 4rpx;
}

.mine-bottom {
  height: calc(170rpx + env(safe-area-inset-bottom));
}

/* ---------- reminder sheet ---------- */

.push-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #ece0ce;
}

.push-row__main {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.push-row__title {
  font-size: 28rpx;
  font-weight: 600;
}

.push-row__desc {
  font-size: 23rpx;
  color: #635846;
}

.push-note {
  display: block;
  margin-top: 16rpx;
  font-size: 23rpx;
  color: #8b7e68;
}

.push-safe {
  height: calc(24rpx + env(safe-area-inset-bottom));
}

/* ---------- plans sheet ---------- */

.plans__current {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 20rpx;
  border-radius: 2rpx;
  background: #fbf5e9;
}

.plans__current-label {
  display: block;
  font-size: 23rpx;
  color: #873023;
}

.plans__current-name {
  display: block;
  margin-top: 2rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.plans__current-meta {
  display: block;
  margin-top: 2rpx;
  font-size: 23rpx;
  color: #635846;
}

.plans__barcode {
  width: 120rpx;
  height: 44rpx;
  flex: none;
  opacity: 0.5;
  background: repeating-linear-gradient(
    90deg,
    #873023 0,
    #873023 2rpx,
    transparent 2rpx,
    transparent 6rpx,
    #873023 6rpx,
    #873023 8rpx,
    transparent 8rpx,
    transparent 13rpx
  );
}

.plans__list {
  margin-top: 18rpx;
}

.plan-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 18rpx 4rpx;
  border-bottom: 1rpx solid #ece0ce;
}

.plan-row.is-current {
  background: #fffaf2;
}

.plan-row__main {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.plan-row__name {
  font-size: 28rpx;
  font-weight: 600;
}

.plan-row__unit {
  font-size: 23rpx;
  color: #635846;
}

.plan-row__right {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.plan-row__price {
  font-size: 30rpx;
  font-weight: 800;
}

.plans__note {
  display: block;
  margin-top: 16rpx;
  font-size: 23rpx;
  line-height: 1.6;
  color: #8b7e68;
}

.plans__call {
  margin-top: 16rpx;
}

.mine-dev {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 24rpx;
  padding: 14rpx 18rpx;
  border: 1rpx dashed #cfc0a9;
  border-radius: 2rpx;
  font-size: 23rpx;
  color: #8b7e68;
}

.mine-dev__action {
  color: #873023;
}

.phone-bind {
  padding-top: 8rpx;
}

.phone-bind__field {
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 92rpx;
  padding: 0 18rpx;
  border-radius: 2rpx;
  background: #fbf5e9;
}

.phone-bind__prefix {
  font-size: 26rpx;
  color: #635846;
}

.phone-bind__input {
  flex: 1;
  height: 100%;
  font-size: 30rpx;
}

.phone-bind__placeholder {
  color: #8b7e68;
}

.phone-bind__hint {
  display: block;
  margin: 14rpx 0 20rpx;
  font-size: 23rpx;
  line-height: 1.6;
  color: #8b7e68;
}

.phone-bind__safe {
  height: calc(24rpx + env(safe-area-inset-bottom));
}

