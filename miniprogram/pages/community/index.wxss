}

.ranking-row__no {
  width: 40rpx;
  flex: none;
  font-family: "Plex Mono", Consolas, monospace;
  font-size: 20rpx;
  color: #a33b2b;
}

.ranking-row__code {
  flex: 1;
  min-width: 0;
