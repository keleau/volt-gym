/* ---------- community hub links ---------- */

.community-links {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 24rpx;
}

.community-link {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 16rpx 0;
  border-top: 1rpx dashed #d9cbb6;
}

.community-link__kicker {
  display: block;
  font-size: 18rpx;
  letter-spacing: 0.06em;
  color: #72654f;
}

.community-link__title {
  display: block;
  margin-top: 2rpx;
  font-family: "Source Han Serif SC", "Noto Serif CJK SC", "Songti SC", "STSong", "SimSun", serif;
  font-size: 30rpx;
  font-weight: 700;
  color: #1b1712;
