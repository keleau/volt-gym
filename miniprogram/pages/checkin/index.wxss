.checkin {
  height: 100vh;
  overflow: hidden;
  background: #f8f2e6;
}

.ci-scroll {
  width: 100%;
  height: 100vh;
}

.ci-head {
  padding-top: 20rpx;
  padding-bottom: 22rpx;
}

.ci-heading {
  display: block;
  font-size: 44rpx;
  font-weight: 800;
  letter-spacing: -0.04em;
  line-height: 1.2;
}

.ci-sub {
  display: block;
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #635846;
}

.ci-modes {
  display: flex;
  gap: 6rpx;
  margin-bottom: 20rpx;
  padding: 6rpx;
  border: 1rpx solid #d9cbb6;
  background: #efe4d2;
}

.ci-mode {
  flex: 1;
  padding: 16rpx 0;
  color: #635846;
  font-size: 25rpx;
  text-align: center;
}

.ci-mode.is-active {
  background: #1b1712;
  color: #fbf5e9;
  font-weight: 600;
}

/* ---------- scan ---------- */

.scan-card {
  margin: 0 32rpx;
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.scan-card__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 128rpx;
  height: 128rpx;
  margin: 6rpx 0 18rpx;
  border-radius: 4rpx;
  background: #f0ddd6;
}

.scan-frame {
  position: relative;
  width: 56rpx;
  height: 56rpx;
}

.scan-frame__c {
  position: absolute;
  width: 18rpx;
  height: 18rpx;
  border: 4rpx solid #873023;
}

.scan-frame__c--tl {
  top: 0;
  left: 0;
  border-right: 0;
  border-bottom: 0;
  border-radius: 6rpx 0 0 0;
}

.scan-frame__c--tr {
  top: 0;
  right: 0;
  border-left: 0;
  border-bottom: 0;
  border-radius: 0 6rpx 0 0;
}

.scan-frame__c--bl {
  bottom: 0;
  left: 0;
  border-right: 0;
  border-top: 0;
  border-radius: 0 0 0 6rpx;
}

.scan-frame__c--br {
  bottom: 0;
  right: 0;
  border-left: 0;
  border-top: 0;
  border-radius: 0 0 6rpx 0;
}

.scan-frame__line {
  position: absolute;
  left: 8rpx;
  right: 8rpx;
  top: 50%;
  height: 3rpx;
  margin-top: -1rpx;
  background: #a33b2b;
}

.scan-card__title {
  font-size: 36rpx;
  font-weight: 800;
  letter-spacing: -0.02em;
}

.scan-card__desc {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #635846;
}

.scan-card__btn {
  width: 100%;
  margin-top: 24rpx;
}

.scan-card__alt {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #873023;
}

/* ---------- sections ---------- */

.ci-section {
  margin-top: 30rpx;
}

.ci-section__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 14rpx;
}

.ci-section__title {
  font-size: 30rpx;
  font-weight: 700;
}

.ci-section__aside {
  font-size: 24rpx;
  color: #635846;
}

.today-card {
  padding: 24rpx;
}

.today-card__top {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.today-card__time {
  font-size: 40rpx;
  font-weight: 800;
  letter-spacing: -0.03em;
  line-height: 1.1;
}

.today-card__end {
  font-size: 23rpx;
  color: #635846;
}

.today-card__top .tag {
  margin-left: auto;
}

.today-card__name {
  display: block;
  margin-top: 8rpx;
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: -0.02em;
}

.today-card__meta {
  display: block;
  margin-top: 2rpx;
  font-size: 24rpx;
  color: #635846;
}

.today-card__hint {
  display: block;
  margin-top: 10rpx;
  font-size: 23rpx;
  color: #8b7e68;
}

.today-card--empty {
  padding: 28rpx 24rpx;
}

.today-card__empty-title {
  font-size: 30rpx;
  font-weight: 700;
}

.today-card__empty-btn {
  width: auto !important;
  height: 64rpx;
  margin-top: 16rpx;
  padding: 0 24rpx;
  font-size: 24rpx;
}

.venue-card,
.recent-card {
  overflow: hidden;
}

.venue-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 22rpx;
  border-bottom: 1rpx solid #ece0ce;
}

.venue-row:last-child {
  border-bottom: 0;
}

.venue-row--hover {
  background: #fbf5e9;
}

.venue-row.is-today {
  background: #fffaf2;
}

.venue-row__main {
  flex: 1;
  min-width: 0;
}

.venue-row__title-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.venue-row__name {
  font-size: 28rpx;
  font-weight: 600;
}

.venue-row__addr {
  display: block;
  margin-top: 2rpx;
  font-size: 23rpx;
  color: #635846;
}

.venue-row__hours {
  display: block;
  margin-top: 1rpx;
  font-size: 22rpx;
  color: #8b7e68;
}

.venue-row__arrow {
  font-size: 34rpx;
  line-height: 1;
  color: #8b7e68;
}

.recent-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 22rpx;
  border-bottom: 1rpx solid #ece0ce;
}

.recent-row:last-child {
  border-bottom: 0;
}

.recent-row--hover {
  background: #fbf5e9;
}

.recent-row__date {
  display: flex;
  flex-direction: column;
  gap: 1rpx;
  width: 102rpx;
  flex: none;
}

.recent-row__day {
  font-size: 26rpx;
  font-weight: 700;
}

.recent-row__time {
  font-size: 22rpx;
  color: #635846;
}

.recent-row__main {
  flex: 1;
  min-width: 0;
}

.recent-row__name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
}

.recent-row__meta {
  display: block;
  margin-top: 1rpx;
  font-size: 23rpx;
  color: #635846;
}

.recent-row__kcal {
  font-size: 23rpx;
  color: #873023;
  flex: none;
}

.ci-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 28rpx;
  padding-bottom: calc(170rpx + env(safe-area-inset-bottom));
  font-size: 23rpx;
  color: #8b7e68;
}

.ci-foot__phone {
  color: #873023;
}

/* ---------- processing ---------- */

.process {
  position: fixed;
  inset: 0;
  z-index: 380;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 50rpx;
  background: rgba(27, 23, 18, 0.36);
}

.process__panel {
  width: 100%;
  padding: 38rpx 34rpx;
  border-radius: 4rpx;
  background: #fdf9f0;
  text-align: center;
}

.process__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  margin: 0 auto;
  border-radius: 50%;
  background: #f0ddd6;
}

.process__icon .scan-frame {
  width: 48rpx;
  height: 48rpx;
}

.process__title {
  display: block;
  margin-top: 18rpx;
  font-size: 34rpx;
  font-weight: 700;
}

.process__venue {
  display: block;
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #635846;
}

.process__steps {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-top: 20rpx;
  padding: 18rpx;
  border-radius: 2rpx;
  background: #fbf5e9;
  text-align: left;
}

.process__step {
  font-size: 24rpx;
  color: #8b7e68;
}

.process__step.is-done {
  color: #3c342a;
}

.process__step.is-done::before {
  content: "✓";
  margin-right: 8rpx;
  color: #a33b2b;
}

.process__note {
  display: block;
  margin-top: 16rpx;
  font-size: 23rpx;
  color: #8b7e68;
}

/* ---------- success ---------- */

.success {
  position: fixed;
  inset: 0;
  z-index: 500;
  background: #f8f2e6;
}

.success__scroll {
  height: 100vh;
}

.success__inner {
  min-height: 100vh;
  padding-left: 40rpx;
  padding-right: 40rpx;
  padding-bottom: calc(46rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
}

.success__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.success__brand {
  font-family: "Source Han Serif SC", "Noto Serif CJK SC", "Songti SC", "STSong", "SimSun", serif;
  font-size: 40rpx;
  line-height: 1;
  color: #1b1712;
}

.success__slash {
  margin-left: 4rpx;
  color: #a33b2b;
  letter-spacing: -0.14em;
  transform: skewX(-8deg);
}

.success__close {
  position: relative;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #fdf9f0;
}

.success__close--hover {
  background: #fbf5e9;
}

.success__close-line {
  position: absolute;
  top: 27rpx;
  left: 16rpx;
  width: 24rpx;
  height: 2rpx;
  background: #6b6459;
  transform: rotate(45deg);
}

.success__close-line--two {
  transform: rotate(-45deg);
}

.success__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 138rpx;
  height: 138rpx;
  margin: 26rpx auto 0;
  border-radius: 50%;
  background: #f0ddd6;
  color: #a33b2b;
  font-size: 64rpx;
  font-weight: 700;
}

.success__title {
  margin-top: 16rpx;
  font-size: 48rpx;
  font-weight: 800;
  letter-spacing: -0.04em;
  text-align: center;
}

.success__sub {
  display: block;
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #635846;
  text-align: center;
}

.success__card {
  margin-top: 26rpx;
  padding: 24rpx;
}

.success__card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.success__card-label {
  font-size: 24rpx;
  color: #635846;
}

.success__card-kcal {
  font-size: 24rpx;
  color: #873023;
}

.success__card-name {
  display: block;
  margin-top: 8rpx;
  font-size: 36rpx;
  font-weight: 800;
  letter-spacing: -0.03em;
}

.success__card-meta {
  display: block;
  margin-top: 2rpx;
  font-size: 24rpx;
  color: #635846;
}

.success__grid {
  display: flex;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #ece0ce;
}

.success__cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.success__cell + .success__cell {
  padding-left: 18rpx;
  border-left: 1rpx solid #ece0ce;
}

.success__cell-label {
  font-size: 23rpx;
  color: #635846;
}

.success__cell-value {
  font-size: 28rpx;
  font-weight: 700;
}

.success__location {
  display: block;
  margin-top: 14rpx;
  font-size: 23rpx;
  color: #8b7e68;
}

.success__actions {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-top: 24rpx;
}

.success__note {
  display: block;
  margin-top: 22rpx;
  font-size: 22rpx;
  color: #8b7e68;
  text-align: center;
}

.success__week {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 14rpx;
  padding: 14rpx 18rpx;
  border-radius: 2rpx;
  background: #fdf9f0;
  font-size: 23rpx;
  color: #635846;
}

/* ===== VOLT TRAINING LOG / CHECK-IN ===== */

.ci-scroll {
  background: transparent;
}

.ci-head {
  padding-top: 24rpx;
  padding-bottom: 22rpx;
  border-bottom: 1rpx solid #d9cbb6;
}

.ci-head__kicker {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 20rpx;
  letter-spacing: 0.08em;
  color: #635846;
}

.ci-head__node {
  width: 12rpx;
  height: 12rpx;
  background: #a33b2b;
}

.ci-heading {
  display: block;
  margin-top: 8rpx;
  font-family: "Source Han Serif SC", "Noto Serif CJK SC", "Songti SC", "STSong", "SimSun", serif;
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: 0.01em;
  line-height: 1.2;
  color: #1b1712;
}

.ci-sub {
  display: block;
  margin-top: 5rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #635846;
}

/* scan card */

.scan-card {
  position: relative;
  margin-top: 22rpx;
  padding: 30rpx 28rpx 26rpx;
  border: 1rpx solid rgba(27, 23, 18, 0.2);
  border-radius: 4rpx;
  background: #fdf9f0;
  box-shadow: 0 10rpx 24rpx rgba(27, 23, 18, 0.045);
  overflow: visible;
}

.scan-card::before {
  content: "";
  position: absolute;
  top: -12rpx;
  left: 50%;
  width: 84rpx;
  height: 24rpx;
  margin-left: -42rpx;
  background: linear-gradient(180deg, rgba(226, 207, 172, 0.58), rgba(226, 207, 172, 0.28));
  border: 1rpx solid rgba(190, 169, 133, 0.24);
  transform: rotate(-1.5deg);
}

.scan-card__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 152rpx;
  height: 152rpx;
  margin: 0 auto;
  border: 1rpx dashed #a33b2b;
  border-radius: 2rpx;
  background: #f0ddd6;
}

.scan-card__title {
  display: block;
  margin-top: 18rpx;
  font-family: "Source Han Serif SC", "Noto Serif CJK SC", "Songti SC", "STSong", "SimSun", serif;
  font-size: 38rpx;
  font-weight: 700;
  text-align: center;
  color: #1b1712;
}

.scan-card__desc {
  display: block;
  margin-top: 4rpx;
  font-size: 23rpx;
  line-height: 1.55;
  color: #635846;
  text-align: center;
}

.scan-card__btn {
  margin-top: 22rpx !important;
  min-height: 90rpx;
  font-family: "Source Han Serif SC", "Songti SC", "STSong", "SimSun", serif;
  font-size: 30rpx;
  font-weight: 700;
}

.scan-card__alt {
  display: block;
  margin-top: 14rpx;
  padding-bottom: 2rpx;
  border-bottom: 1rpx solid rgba(163, 59, 43, 0.4);
  font-size: 22rpx;
  color: #873023;
  text-align: center;
}

/* sections */

.ci-section {
  margin-top: 34rpx;
}

.ci-section__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  padding-bottom: 9rpx;
  border-bottom: 1rpx solid #d9cbb6;
}

.ci-section__title {
  font-family: "Source Han Serif SC", "Noto Serif CJK SC", "Songti SC", "STSong", "SimSun", serif;
  font-size: 36rpx;
  font-weight: 700;
  color: #1b1712;
}

.ci-section__aside {
  font-family: "Plex Mono", Consolas, monospace;
  font-size: 20rpx;
  color: #72654f;
}

/* today class */

