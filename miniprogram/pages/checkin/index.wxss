}

.today-card__top {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
}

.today-card__time {
  font-family: "Source Han Serif SC", "Noto Serif CJK SC", "Songti SC", "STSong", "SimSun", serif;
  font-size: 54rpx;
  font-weight: 700;
  line-height: 1;
  color: #1b1712;
}

.today-card__end {
  font-family: "Plex Mono", Consolas, monospace;
  font-size: 20rpx;
  color: #72654f;
}

.today-card__top .tag {
  margin-left: auto;
}

.today-card__name {
  display: block;
  margin-top: 8rpx;
  font-family: "Source Han Serif SC", "Noto Serif CJK SC", "Songti SC", "STSong", "SimSun", serif;
  font-size: 34rpx;
  font-weight: 700;
  color: #1b1712;
}

.today-card__meta {
  display: block;
  margin-top: 3rpx;
  font-size: 22rpx;
  color: #635846;
}

.today-card__hint {
  display: inline-block;
  margin-top: 12rpx;
  padding-top: 10rpx;
  border-top: 1rpx dashed #d9cbb6;
  font-size: 22rpx;
  color: #873023;
}

.today-card--empty {
  padding: 24rpx;
}

.today-card__empty-title {
  display: block;
  font-family: "Source Han Serif SC", "Songti SC", "SimSun", serif;
  font-size: 32rpx;
  font-weight: 700;
  color: #1b1712;
}

.today-card__empty-btn {
  margin-top: 14rpx !important;
}

/* venue list */

.venue-card,
.recent-card {
  margin-top: 16rpx;
  padding: 0 20rpx;
  border: 1rpx solid rgba(27, 23, 18, 0.18);
  border-radius: 4rpx;
  background: #fdf9f0;
  box-shadow: 0 8rpx 18rpx rgba(27, 23, 18, 0.035);
}

.venue-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx dashed #d9cbb6;
}

.venue-row:last-child {
  border-bottom: 0;
}

.venue-row--hover {
  background: #fbf5e9;
}

.venue-row.is-today {
  background: #fbf5e9;
}

.venue-row__main {
  flex: 1;
  min-width: 0;
}

.venue-row__title-row {
  display: flex;
  align-items: baseline;
  gap: 9rpx;
}

.venue-row__index {
  flex: none;
  font-size: 18rpx;
  color: #a33b2b;
}

.venue-row__name {
  font-family: "Source Han Serif SC", "Noto Serif CJK SC", "Songti SC", "STSong", "SimSun", serif;
  font-size: 30rpx;
  font-weight: 700;
  color: #1b1712;
}

.venue-row__addr,
.venue-row__hours {
  display: block;
  margin-top: 2rpx;
  font-size: 21rpx;
  color: #635846;
}

.venue-row__arrow {
  flex: none;
  color: #a33b2b;
  font-size: 30rpx;
}

/* recent records */

.recent-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 15rpx 0;
  border-bottom: 1rpx dashed #d9cbb6;
}

.recent-row:last-child {
  border-bottom: 0;
}

.recent-row::before {
  content: "✓";
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34rpx;
  height: 34rpx;
  flex: none;
  background: #66705b;
  color: #fbf5e9;
  font-size: 20rpx;
  line-height: 1;
}

.recent-row__date {
  width: 92rpx;
  flex: none;
}

.recent-row__day {
  display: block;
  font-family: "Plex Mono", Consolas, monospace;
  font-size: 18rpx;
  color: #635846;
}

.recent-row__time {
  display: block;
  margin-top: 2rpx;
  font-family: "Plex Mono", Consolas, monospace;
  font-size: 18rpx;
  color: #72654f;
}

.recent-row__main {
  flex: 1;
  min-width: 0;
}

.recent-row__name {
  display: block;
  font-family: "Source Han Serif SC", "Songti SC", "STSong", "SimSun", serif;
  font-size: 27rpx;
  font-weight: 700;
  color: #1b1712;
}

.recent-row__meta {
  display: block;
  margin-top: 1rpx;
  font-size: 20rpx;
  color: #635846;
}

.recent-row__kcal {
  flex: none;
  font-family: "Plex Mono", Consolas, monospace;
  font-size: 19rpx;
  color: #873023;
}

.ci-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 28rpx;
  padding-top: 14rpx;
  border-top: 1rpx dashed #d9cbb6;
  font-family: "Plex Mono", Consolas, monospace;
  font-size: 19rpx;
  color: #72654f;
}

.ci-foot__phone {
  color: #873023;
}

/* processing */

.process {
  background: rgba(27, 23, 18, 0.38);
}

.process__panel {
  padding: 34rpx 30rpx;
  border: 1rpx solid #1b1712;
  border-radius: 2rpx;
  background: #fbf5e9;
  text-align: center;
}

.process__icon {
  width: 128rpx;
  height: 128rpx;
  border: 1rpx dashed #a33b2b;
  border-radius: 2rpx;
  background: #f0ddd6;
}

.process__title {
  font-family: "Source Han Serif SC", "Songti SC", "SimSun", serif;
  font-size: 38rpx;
  font-weight: 700;
  color: #1b1712;
}

.process__venue {
  font-size: 22rpx;
  color: #635846;
}

.process__steps {
  border: 1rpx dashed #d9cbb6;
  background: #fdf9f0;
}

.process__step {
  font-size: 23rpx;
  color: #72654f;
}

.process__step.is-done {
  color: #1b1712;
}

.process__step.is-done::before {
  color: #66705b;
}

.process__note {
  font-family: "Plex Mono", Consolas, monospace;
  font-size: 19rpx;
  color: #72654f;
}

/* success */

.success {
  background-color: #f8f2e6;
  background-image: radial-gradient(rgba(27, 23, 18, 0.025) 1rpx, transparent 1rpx);
  background-size: 32rpx 32rpx;
}

.success__close {
  border: 1rpx solid #c9b99f;
  border-radius: 2rpx;
  background: #fdf9f0;
}

.success__close--hover {
  background: #efe4d2;
}

.success__close-line {
  background: #1b1712;
}

.success__stamp {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 218rpx;
  height: 218rpx;
  margin: 30rpx auto 0;
  border: 3rpx solid #a33b2b;
  border-radius: 50%;
  color: #a33b2b;
  background: rgba(253, 249, 240, 0.5);
  transform: rotate(-8deg);
  opacity: 0.92;
}

.success__stamp::before {
  content: "";
  position: absolute;
  inset: 12rpx;
  border: 2rpx dashed rgba(163, 59, 43, 0.55);
  border-radius: 50%;
}

.success__stamp-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  text-align: center;
}

.success__stamp-top,
.success__stamp-bottom {
  font-family: "Plex Mono", Consolas, monospace;
  font-size: 16rpx;
  letter-spacing: 0.08em;
  line-height: 1.4;
}

.success__stamp-main {
  font-family: "Source Han Serif SC", "Noto Serif CJK SC", "Songti SC", "STSong", "SimSun", serif;
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 0.04em;
  line-height: 1.2;
}

.success__kicker {
  margin-top: 26rpx;
  font-size: 20rpx;
  letter-spacing: 0.08em;
  color: #a33b2b;
  text-align: center;
}

.success__title {
  margin-top: 4rpx;
  font-family: "Source Han Serif SC", "Noto Serif CJK SC", "Songti SC", "STSong", "SimSun", serif;
  font-size: 54rpx;
  font-weight: 700;
  letter-spacing: 0.01em;
  text-align: center;
  color: #1b1712;
}

.success__sub {
  font-size: 23rpx;
  color: #635846;
}

.success__card {
  margin-top: 24rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(27, 23, 18, 0.2);
  border-radius: 4rpx;
  background: #fdf9f0;
  box-shadow: 0 8rpx 18rpx rgba(27, 23, 18, 0.045);
}

.success__card-label {
  font-family: "Plex Mono", Consolas, monospace;
  font-size: 19rpx;
  color: #72654f;
}

.success__card-kcal {
  font-family: "Plex Mono", Consolas, monospace;
  font-size: 20rpx;
  color: #873023;
}

.success__card-name {
  font-family: "Source Han Serif SC", "Noto Serif CJK SC", "Songti SC", "STSong", "SimSun", serif;
  font-size: 36rpx;
  font-weight: 700;
}

.success__card-meta {
  font-size: 22rpx;
  color: #635846;
}

.success__grid {
  border-top: 1rpx dashed #d9cbb6;
}

.success__cell + .success__cell {
  border-left: 1rpx dashed #d9cbb6;
}

.success__cell-label {
  font-size: 20rpx;
  color: #72654f;
}

.success__cell-value {
  font-family: "Source Han Serif SC", "Songti SC", "SimSun", serif;
  font-size: 30rpx;
  font-weight: 700;
  color: #1b1712;
}

.success__location {
  font-family: "Plex Mono", Consolas, monospace;
  font-size: 19rpx;
  color: #72654f;
}

.success__week {
  border: 1rpx dashed #d9cbb6;
  background: #fbf5e9;
  font-size: 22rpx;
}

.success__note {
  font-family: "Plex Mono", Consolas, monospace;
  font-size: 18rpx;
  color: #72654f;
}

.ci-foot {
  margin-top: 30rpx;
  padding-top: 16rpx;
}

.ci-foot__note {
  max-width: 420rpx;
  font-family: "STSong", "Songti SC", "SimSun", serif;
  font-size: 22rpx;
  line-height: 1.5;
  color: #635846;
}
