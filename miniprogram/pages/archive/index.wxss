.archive {
  min-height: 100vh;
  background: #f8f2e6;
}

.ar-body {
  position: relative;
}

.nav-share {
  width: auto !important;
  height: 54rpx;
  padding: 0 14rpx;
  border: 1rpx solid #c9b99f;
  border-radius: 2rpx;
  background: #fdf9f0;
  color: #873023;
  font-size: 21rpx;
  line-height: 52rpx;
}

/* ---------- head ---------- */

.ar-head {
  padding-top: 24rpx;
  padding-bottom: 18rpx;
}

.ar-kicker {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 20rpx;
  letter-spacing: 0.08em;
  color: #635846;
}

.ar-kicker__node {
  width: 12rpx;
  height: 12rpx;
  flex: none;
  background: #a33b2b;
}

.ar-title {
  display: block;
  margin-top: 8rpx;
  font-family: "Source Han Serif SC", "Noto Serif CJK SC", "Songti SC", "STSong", "SimSun", serif;
  font-size: 54rpx;
  font-weight: 700;
  letter-spacing: 0.01em;
  line-height: 1.2;
  color: #1b1712;
}

.ar-sub {
  display: block;
  margin-top: 5rpx;
  font-size: 23rpx;
  line-height: 1.55;
  color: #635846;
}

/* ---------- chart: page focal point ---------- */

.ar-chart-wrap {
  padding-top: 4rpx;
}

.ar-chart-card {
  position: relative;
  padding: 24rpx 20rpx 14rpx;
  border: 1rpx solid rgba(27, 23, 18, 0.2);
  border-radius: 4rpx;
  background-color: #fdf9f0;
  background-image:
    linear-gradient(rgba(27, 23, 18, 0.055) 1rpx, transparent 1rpx),
    linear-gradient(90deg, rgba(27, 23, 18, 0.055) 1rpx, transparent 1rpx);
  background-size: 26rpx 26rpx;
  box-shadow: 0 12rpx 28rpx rgba(27, 23, 18, 0.055);
  overflow: hidden;
}

.ar-chart-card::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  width: 104rpx;
  height: 6rpx;
  background: #a33b2b;
}

.ar-chart__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  padding: 2rpx 4rpx 2rpx;
}

.ar-chart__stat {
  flex: 1;
  min-width: 0;
}

.ar-chart__meta {
  font-size: 17rpx;
  letter-spacing: 0.07em;
  color: #72654f;
}

.ar-chart__value-row {
  display: flex;
  align-items: baseline;
  gap: 7rpx;
  margin-top: 1rpx;
}

.ar-chart__value {
  font-family: "Source Han Serif SC", "Noto Serif CJK SC", "Songti SC", "STSong", "SimSun", serif;
  font-size: 62rpx;
  font-weight: 700;
  line-height: 1.05;
  letter-spacing: -0.01em;
  color: #1b1712;
}

.ar-chart__unit {
  font-size: 18rpx;
  color: #873023;
}

.ar-chart__label {
  display: block;
  margin-top: 2rpx;
  font-size: 20rpx;
  color: #635846;
}

.ar-toggle {
  display: flex;
  align-items: center;
  gap: 18rpx;
  flex: none;
  padding-top: 6rpx;
}

.ar-toggle__item {
  padding: 2rpx 0 7rpx;
  border-bottom: 3rpx solid transparent;
  font-size: 21rpx;
  color: #635846;
}

.ar-toggle__item.is-active {
  border-bottom-color: #a33b2b;
  color: #a33b2b;
  font-weight: 700;
}

.ar-chart__foot {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  margin: 4rpx 4rpx 0;
  padding-top: 10rpx;
  border-top: 1rpx dashed #d9cbb6;
  font-size: 20rpx;
  color: #635846;
}

.ar-chart__foot .mono {
  flex: none;
  font-size: 16rpx;
  color: #72654f;
}

/* ---------- actions ---------- */

.ar-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 20rpx;
}

.ar-action {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  flex: 1;
  min-height: 78rpx;
  padding: 0 16rpx;
  border: 1rpx solid #c9b99f;
  border-radius: 2rpx;
  background: #fdf9f0;
  color: #1b1712;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.2;
  text-align: center;
}

.ar-action--primary {
  flex: 1.2;
  border-color: #a33b2b;
  background: #a33b2b;
  color: #fbf5e9;
}

.ar-action__arrow {
  font-family: "Plex Mono", Consolas, monospace;
  font-size: 26rpx;
  font-weight: 400;
}

/* ---------- latest ---------- */

.ar-last-wrap {
  margin-top: 26rpx;
}

.ar-last__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.ar-last__label {
  font-size: 18rpx;
  letter-spacing: 0.05em;
  color: #a33b2b;
}

.ar-last__all {
  flex: none;
  padding-bottom: 2rpx;
  border-bottom: 1rpx solid rgba(163, 59, 43, 0.35);
  color: #873023;
  font-size: 20rpx;
}

.ar-last__card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 10rpx;
  padding: 16rpx;
  border: 1rpx solid rgba(27, 23, 18, 0.18);
  border-radius: 4rpx;
  background: #fdf9f0;
  box-shadow: 0 6rpx 16rpx rgba(27, 23, 18, 0.035);
}

.ar-last__img {
  width: 104rpx;
  height: 104rpx;
  flex: none;
  padding: 4rpx;
  border: 1rpx solid #d9cbb6;
  background: #fffaf0;
  object-fit: cover;
  transform: rotate(-1deg);
}

.ar-last__main {
  flex: 1;
  min-width: 0;
}

.ar-last__name {
  display: block;
  font-family: "Source Han Serif SC", "Noto Serif CJK SC", "Songti SC", "STSong", "SimSun", serif;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.25;
  color: #1b1712;
}

.ar-last__meta {
  display: block;
  margin-top: 3rpx;
  overflow: hidden;
  font-size: 20rpx;
  line-height: 1.4;
  color: #635846;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ar-last__check {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34rpx;
  height: 34rpx;
  flex: none;
  background: #66705b;
  color: #fbf5e9;
  font-size: 18rpx;
}

/* ---------- footer ---------- */

.ar-empty {
  margin-top: 22rpx;
}

.ar-more {
  display: flex;
  align-items: baseline;
  gap: 20rpx;
  margin-top: 28rpx;
  padding-top: 14rpx;
  border-top: 1rpx dashed #d9cbb6;
}

.ar-more__label {
  flex: 1;
  font-family: "STSong", "Songti SC", "SimSun", serif;
  font-size: 22rpx;
  color: #635846;
}

.ar-more__link {
  flex: none;
  padding-bottom: 2rpx;
  border-bottom: 1rpx solid rgba(163, 59, 43, 0.35);
  color: #873023;
  font-size: 21rpx;
}

.ar-bottom {
  height: calc(170rpx + env(safe-area-inset-bottom));
}

/* ---------- body sheet ---------- */

.body-form {
  padding-top: 4rpx;
}

.body-form__fields {
  display: flex;
  gap: 16rpx;
}

.body-form__field {
  flex: 1;
  min-width: 0;
  padding: 14rpx 16rpx;
  border: 1rpx solid #d9cbb6;
  background: #fdf9f0;
}

.body-form__label {
  display: block;
  font-family: "Plex Mono", Consolas, monospace;
  font-size: 19rpx;
  color: #72654f;
}

.body-form__input-row {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin-top: 4rpx;
}

.body-form__input {
  flex: 1;
  min-width: 0;
  font-family: "Source Han Serif SC", "Songti SC", "SimSun", serif;
  font-size: 34rpx;
  font-weight: 700;
  color: #1b1712;
}

.body-form__placeholder {
  color: #9b8d77;
}

.body-form__unit {
  font-size: 20rpx;
  color: #635846;
}

.body-form__bmi {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 16rpx;
  padding: 16rpx;
  border: 1rpx dashed #d9cbb6;
  background: #fbf5e9;
}

.body-form__bmi-label {
  display: block;
  font-family: "Plex Mono", Consolas, monospace;
  font-size: 17rpx;
  color: #72654f;
}

.body-form__bmi-value {
  display: block;
  font-family: "Source Han Serif SC", "Songti SC", "SimSun", serif;
  font-size: 34rpx;
  font-weight: 700;
  color: #1b1712;
}

.body-form__bmi-note {
  flex: 1;
  font-size: 20rpx;
  line-height: 1.5;
  color: #635846;
}

.body-form__last {
  display: block;
  margin-top: 12rpx;
  font-family: "Plex Mono", Consolas, monospace;
  font-size: 18rpx;
  color: #72654f;
}

.body-form__save {
  margin-top: 20rpx !important;
}

.body-form__fine {
  display: block;
  margin-top: 10rpx;
  font-size: 20rpx;
  color: #72654f;
  text-align: center;
}
