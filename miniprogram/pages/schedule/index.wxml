<template name="session-card">
  <view class="class-card card" data-id="{{id}}" bindtap="openSession" hover-class="class-card--hover">
    <view class="class-card__main">
      <view class="class-card__time">
        <text class="class-card__clock">{{startTime}}</text>
        <text class="class-card__duration">{{durationMin}} 分钟</text>
      </view>
      <view class="class-card__info">
        <view class="class-card__name-row">
          <text class="class-card__name">{{programName}}</text>
          <text class="tag {{tagClass}}">{{statusLabel}}</text>
        </view>
        <text class="class-card__meta">{{coachName}} · {{venueName}}</text>
        <text class="class-card__seats">{{left > 0 ? '余 ' + left + ' 位' : '名额已满'}} · {{intensity}}</text>
      </view>
      <image class="class-card__img" src="{{programImage}}" mode="aspectFill"></image>
    </view>
    <view class="class-card__foot">
      <text class="class-card__extra">{{programEn}} · {{kcal}} kcal</text>
      <view class="class-card__action {{tone === 'go' ? 'is-primary' : ''}}">{{actionLabel}}</view>
    </view>
  </view>
</template>

<view class="page schedule">
  <volt-nav placeholder="{{false}}" title="预约课程"></volt-nav>

  <scroll-view class="sch-scroll" scroll-y enhanced show-scrollbar="{{false}}" scroll-top="{{scrollTop}}">
    <view style="height:{{nav.totalHeight}}px"></view>

    <view wx:if="{{loading}}" class="loading"><view class="loading__bar"></view><text>正在加载课表</text></view>

    <block wx:else>
      <view wx:if="{{!selectedVenueCode}}" class="venue-step wrap">
        <view class="step-head">
          <view class="step-head__main">
            <text class="step-head__no">01</text>
            <text class="step-head__title">选择门店</text>
          </view>
          <text class="step-head__action" bindtap="onLocate">{{locating ? '定位中…' : '定位最近'}}</text>
        </view>
        <text class="step-sub">先选门店，再看该店教练与场次。</text>

        <view
          wx:for="{{venues}}"
          wx:key="code"
          class="store-card card"
          data-code="{{item.code}}"
          bindtap="selectVenue"
          hover-class="store-card--hover"
        >
          <image class="store-card__img" src="{{item.imageUrl}}" mode="aspectFill"></image>
          <view class="store-card__main">
            <view class="store-card__title-row">
              <text class="store-card__name">{{item.name}}</text>
              <text class="tag {{item.todaySlots > 0 ? 'tag--acid' : 'tag--paper'}}">{{item.todaySlots > 0 ? '今日 ' + item.todaySlots + ' 节可约' : '今日已结束'}}</text>
            </view>
            <text class="store-card__addr">{{item.address}}</text>
            <text class="store-card__metro">{{item.metro}}</text>
            <view class="store-card__foot">
              <text class="store-card__hours">{{item.hours}}</text>
              <text wx:if="{{item.distanceText}}" class="store-card__distance">{{item.distanceText}}</text>
            </view>
          </view>
          <text class="store-card__arrow">›</text>
        </view>

        <view class="venue-note">三店独立库存，选店后再查看教练与场次。</view>
      </view>

      <block wx:else>
        <view class="sch-head wrap">
          <view class="store-bar card">
            <image class="store-bar__img" src="{{selectedVenue.imageUrl}}" mode="aspectFill"></image>
            <view class="store-bar__main">
              <text class="store-bar__name">{{selectedVenue.name}}</text>
              <text class="store-bar__meta">{{selectedVenue.metro}} · 今日 {{selectedVenue.todaySlots}} 节可约</text>
            </view>
            <text class="store-bar__change" bindtap="changeVenue">更换</text>
          </view>

          <view class="mode-switch">
            <view class="mode-item {{mode === 'coach' ? 'is-active' : ''}}" data-mode="coach" bindtap="switchMode">按教练约</view>
            <view class="mode-item {{mode === 'time' ? 'is-active' : ''}}" data-mode="time" bindtap="switchMode">按时间约</view>
          </view>

          <view wx:if="{{programName}}" class="program-filter">
            已筛选：{{programName}}
            <text class="program-filter__clear" bindtap="clearProgramFilter">清除</text>
          </view>
        </view>

        <view wx:if="{{trialMode && trial.available}}" class="trial-banner">
          <text class="trial-banner__tag mono">{{trial.free ? 'MEMBER GIFT / 会员赠课' : 'TRIAL / 首次体验'}}</text>
          <text class="trial-banner__title serif">{{trial.free ? '会员赠课 · 免费体验一次' : '¥49 先练一次，不扣次卡'}}</text>
          <text class="trial-banner__desc">{{trial.free ? '随卡赠送 · 每个手机号限一次' : '到店付款 · 一个手机号限约一次'}}</text>
        </view>

        <view wx:if="{{mode === 'coach'}}" class="coach-strip-wrap wrap">
          <scroll-view scroll-x class="coach-strip" enhanced show-scrollbar="{{false}}">
            <view class="coach-chip {{!selectedCoachId ? 'is-active' : ''}}" bindtap="clearCoach">
              <view class="coach-chip__main">
                <text class="coach-chip__name">全部教练</text>
                <text class="coach-chip__meta mono">{{venueCoaches.length}} 位</text>
              </view>
            </view>
            <view
              wx:for="{{venueCoaches}}"
              wx:key="id"
              class="coach-chip {{selectedCoachId === item.id ? 'is-active' : ''}}"
              data-id="{{item.id}}"
              bindtap="selectCoach"
            >
              <image class="coach-chip__avatar" src="{{item.avatarUrl}}" mode="aspectFill"></image>
              <view class="coach-chip__main">
                <text class="coach-chip__name">{{item.name}}</text>
                <text class="coach-chip__meta mono">7 天 {{item.slotsLeft}} 节</text>
              </view>
            </view>
          </scroll-view>
        </view>

        <view class="date-section wrap">
          <view class="date-strip">
            <view
              wx:for="{{dayViews}}"
              wx:key="iso"
              class="date {{item.isActive ? 'is-active' : ''}} {{item.isToday ? 'is-today' : ''}} {{item.availableCount ? '' : 'is-empty'}}"
              data-date="{{item.iso}}"
              bindtap="selectDate"
            >
              <text class="date__tag">{{item.isToday ? '今天' : item.tag}}</text>
              <text class="date__num">{{item.short}}</text>
              <text class="date__count">{{item.countLabel}}</text>
            </view>
          </view>
        </view>

        <view class="list-head wrap">
          <text class="list-head__day">{{selectedDateLabel}}</text>
          <text class="list-head__count">{{sessions.length}} 节 · {{selectedVenue.name}}</text>
        </view>

        <view wx:if="{{loadingSessions}}" class="loading"><view class="loading__bar"></view><text>正在加载场次</text></view>

        <block wx:elif="{{sessions.length}}">
          <view wx:if="{{mode === 'time'}}" class="time-list wrap">
            <view wx:for="{{timeGroups}}" wx:key="key" class="time-group">
              <view class="time-group__head">
                <text class="time-group__label">{{item.label}}</text>
                <text class="time-group__range">{{item.range}}</text>
              </view>
              <block wx:for="{{item.sessions}}" wx:for-item="session" wx:key="id">
                <template is="session-card" data="{{...session}}" />
              </block>
            </view>
          </view>
          <view wx:else class="sch-list wrap">
            <block wx:for="{{sessions}}" wx:for-item="session" wx:key="id">
              <template is="session-card" data="{{...session}}" />
            </block>
          </view>
        </block>

        <view wx:else class="sch-empty wrap">
          <view class="empty">
            <view class="empty__icon">—</view>
            <text class="empty__title">这天没有可约场次</text>
            <text class="empty__desc">换一个日期，或切换其他教练/门店。</text>
            <button class="empty__btn" bindtap="changeVenue">更换门店</button>
          </view>
        </view>

        <view class="sch-note wrap">先选门店，再按教练或时间约课；锁位后 10 分钟内确认。</view>
      </block>
    </block>
  </scroll-view>

  <volt-sheet
    visible="{{sheetVisible}}"
    title="{{sheetTitle}}"
    subtitle="{{sheetSubtitle}}"
    maxHeight="86vh"
    bind:close="onCloseSheet"
  >
    <view wx:if="{{selected}}" class="bk">
      <view class="bk-hero">
        <image class="bk-hero__img" src="{{selected.programImage}}" mode="aspectFill"></image>
        <view class="bk-hero__info">
          <text class="bk-hero__name">{{selected.programName}}</text>
          <text class="bk-hero__meta">{{selected.dateShort}} · {{selected.startTime}}–{{selected.endTime}}</text>
          <text class="bk-hero__meta">{{selected.coachName}} · {{selected.venueName}}</text>
        </view>
      </view>

      <view class="bk-rows">
        <view class="bk-row"><text class="bk-row__label">日期</text><text class="bk-row__value">{{selected.dateShort}} {{selected.dayCn}}</text></view>
        <view class="bk-row"><text class="bk-row__label">门店</text><text class="bk-row__value">{{selected.venueName}}</text></view>
        <view class="bk-row"><text class="bk-row__label">教练</text><text class="bk-row__value">{{selected.coachName}}</text></view>
        <view class="bk-row"><text class="bk-row__label">课程</text><text class="bk-row__value">{{selected.durationMin}} 分钟 · {{selected.intensity}}</text></view>
      </view>

      <view wx:if="{{sheetState === 'book' || sheetState === 'waitlist'}}" class="bk-reminder">
        <view class="bk-reminder__main">
          <text class="bk-reminder__title">开课提醒</text>
          <text class="bk-reminder__desc">开课前 60 分钟通过微信服务通知提醒</text>
        </view>
        <switch checked="{{reminder}}" color="#A33B2B" bindchange="onToggleReminder" />
      </view>

      <view wx:if="{{sheetState === 'book'}}" class="bk-actions">
        <view wx:if="{{trialMode && trial.available}}" class="bk-credit-line">
          <text>{{trial.free ? '会员赠课 ¥0' : '首次体验 ¥49'}}</text>
          <text>不扣次卡</text>
        </view>
        <view wx:else class="bk-credit-line"><text>次卡扣 1 次</text><text>余额 {{member.credits}} 次</text></view>
        <button class="btn btn--primary btn--block" bindtap="onBook">{{trialMode && trial.available ? (trial.free ? '预约免费体验课' : '预约体验课') : '锁定名额'}}</button>
        <text wx:if="{{trialMode && trial.available}}" class="bk-fine">{{trial.free ? '随卡赠送 · 不扣次卡 · 每个手机号限一次' : '提交后直接确认，到店付 ¥49；每个手机号限一次'}}</text>
        <text wx:else class="bk-fine">锁定后 10 分钟内确认，逾期自动释放</text>
      </view>

      <view wx:elif="{{sheetState === 'waitlist'}}" class="bk-actions">
        <view class="bk-notice">当前场次已满，加入候补后有人取消会按顺序递补。</view>
        <button class="btn btn--primary btn--block" bindtap="joinWaitlist">加入候补</button>
        <text class="bk-fine">候补免费，递补成功后再确认预约</text>
      </view>

      <view wx:elif="{{sheetState === 'locked'}}" class="bk-actions">
        <view class="bk-locked">
          <view>
            <text class="bk-locked__title">名额已锁定</text>
            <text class="bk-locked__desc">请在倒计时内确认，逾期自动释放</text>
          </view>
          <text class="bk-locked__time">{{lockText}}</text>
        </view>
        <button class="btn btn--primary btn--block" bindtap="confirmBooking">确认预约</button>
        <button class="bk-text-btn" bindtap="releaseLock">释放名额</button>
      </view>

      <view wx:elif="{{sheetState === 'waitlisted'}}" class="bk-actions">
        <view class="bk-success">
          <text class="bk-success__title">已进入候补</text>
          <text class="bk-success__desc">当前第 {{waitlistResult.position}} 位，有空位会通过微信服务通知提醒。</text>
        </view>
        <button class="btn btn--ghost btn--block" bindtap="goBookings">查看我的预约</button>
      </view>

      <view wx:elif="{{sheetState === 'confirmed'}}" class="bk-actions">
        <view class="bk-confirmed">
          <view class="bk-confirmed__icon">✓</view>
          <view class="bk-confirmed__main">
            <text class="bk-confirmed__title">{{bookingResult.isTrial ? '体验课预约成功' : '预约成功'}}</text>
            <text wx:if="{{bookingResult.isTrial}}" class="bk-confirmed__desc">体验课预约号 {{bookingResult.orderNo}} · {{bookingResult.dateShort}} {{bookingResult.startTime}}</text>
            <text wx:else class="bk-confirmed__desc">预约号 {{bookingResult.orderNo}} · {{bookingResult.dateShort}} {{bookingResult.startTime}}</text>
          </view>
        </view>
        <view class="bk-entry">
          <view>
            <text class="bk-entry__label">进场码</text>
            <text class="bk-entry__code">{{bookingResult.entryCode}}</text>
          </view>
          <text class="bk-entry__hint">{{bookingResult.isTrial ? (bookingResult.amount > 0 ? '到店付 ¥' + bookingResult.amount + '，向前台出示或扫码核销' : '会员赠课 · 免费，向前台出示或扫码核销') : '到店后向前台出示，或扫码核销'}}</text>
        </view>
        <button class="btn btn--primary btn--block" bindtap="goBookings">查看我的预约</button>
        <button wx:if="{{bookingResult.isTrial}}" class="btn btn--ghost btn--block bk-secondary" bindtap="goPass">看看会员卡</button>
        <button wx:else class="btn btn--ghost btn--block bk-secondary" bindtap="goCheckin">去进场</button>
      </view>

      <view wx:elif="{{sheetState === 'manage'}}" class="bk-actions">
        <view class="bk-success">
          <text class="bk-success__title">{{selected.myStatus === 'waitlisted' ? '候补中' : selected.myStatus === 'locked' ? '待确认' : '已预约'}}</text>
          <text class="bk-success__desc">{{selected.myStatus === 'waitlisted' ? '当前第 ' + selected.waitlistPosition + ' 位。' : '凭进场码到店，开课前扫码核销。'}}</text>
          <text wx:if="{{selected.myStatus === 'locked'}}" class="bk-fine">剩余 {{lockText}}</text>
        </view>
        <view wx:if="{{selected.myStatus === 'confirmed'}}" class="bk-manage">
          <button class="btn btn--primary bk-manage__btn" bindtap="goCheckin">去进场</button>
          <button class="btn btn--ghost bk-manage__btn" bindtap="cancelExisting">取消预约</button>
        </view>
        <view wx:elif="{{selected.myStatus === 'locked'}}" class="bk-manage">
          <button class="btn btn--primary bk-manage__btn" bindtap="confirmBooking">确认预约</button>
          <button class="btn btn--ghost bk-manage__btn" bindtap="releaseLock">释放名额</button>
        </view>
        <view wx:else class="bk-manage">
          <button class="btn btn--ghost btn--block" bindtap="cancelExisting">退出候补</button>
        </view>
      </view>

      <button class="bk-share" open-type="share">分享这节课给好友</button>
    </view>
  </volt-sheet>
</view>
