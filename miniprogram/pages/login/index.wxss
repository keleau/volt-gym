.login-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: #f8f2e6;
  color: #1b1712;
}

.login-page__body {
  flex: 1;
  padding-top: 90rpx;
}

.login-kicker {
  font-size: 19rpx;
  letter-spacing: .1em;
  color: #8b7e68;
}

.login-kicker__node {
  display: inline-block;
  width: 10rpx;
  height: 10rpx;
  margin-right: 8rpx;
  background: #a33b2b;
}

.login-title {
  display: block;
  margin-top: 16rpx;
  font-size: 62rpx;
  line-height: 1.22;
  letter-spacing: -.03em;
}

.login-title__hl {
  color: #a33b2b;
}

.login-desc {
  display: block;
  margin-top: 24rpx;
  font-size: 25rpx;
  line-height: 1.7;
  color: #635846;
}

.login-btn {
  margin-top: 48rpx;
}

.login-alt {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 26rpx;
  padding-bottom: 22rpx;
  border-bottom: 1rpx dashed #d9cbb6;
  font-size: 24rpx;
  color: #873023;
}

.login-alt__arrow {
  font-size: 32rpx;
  line-height: 1;
}

.login-note {
  display: block;
  margin-top: 22rpx;
  font-size: 21rpx;
  line-height: 1.6;
  color: #8b7e68;
}

.login-page__foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #e7dcc9;
  font-size: 20rpx;
  color: #8b7e68;
}

.login-page__phone {
  color: #873023;
}
