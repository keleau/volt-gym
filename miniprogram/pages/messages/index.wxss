.messages {
  height: 100vh;
  overflow: hidden;
  background: #f8f2e6;
}

.msg-scroll {
  width: 100%;
  height: 100vh;
}

.msg-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
  padding-top: 20rpx;
  padding-bottom: 18rpx;
}

.msg-head__title {
  display: block;
  font-size: 40rpx;
  font-weight: 800;
  letter-spacing: -0.03em;
}

.msg-head__sub {
  display: block;
  margin-top: 2rpx;
  font-size: 23rpx;
  color: #635846;
}

.msg-head__read {
  font-size: 24rpx;
  color: #873023;
}

.msg-push {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 2rpx;
  background: #fbf5e9;
}

.msg-push__dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #a33b2b;
  flex: none;
}

.msg-push__main {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 1rpx;
}

.msg-push__title {
  font-size: 24rpx;
  font-weight: 600;
}

.msg-push__desc {
  font-size: 22rpx;
  color: #635846;
}

.msg-push__action {
  font-size: 23rpx;
  color: #873023;
  flex: none;
}

.msg-filters {
  width: 100%;
}

.msg-filters__track {
  display: flex;
  gap: 8rpx;
  padding: 0 32rpx;
}

.msg-filter {
  height: 54rpx;
  padding: 0 20rpx;
  border-radius: 4rpx;
  background: #fdf9f0;
  border: 1rpx solid #d9cbb6;
  font-size: 24rpx;
  line-height: 52rpx;
  color: #635846;
  flex: none;
}

.msg-filter.is-active {
  background: #1b1712;
  border-color: #1b1712;
  color: #fbf5e9;
  font-weight: 600;
}

.msg-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  padding-top: 16rpx;
}

.msg-card {
  padding: 20rpx;
}

.msg-card--hover {
  background: #fbf5e9;
}

.msg-card.is-read {
  opacity: 0.72;
}

.msg-card__top {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.msg-card__type {
  font-size: 23rpx;
  color: #873023;
}

.msg-card__time {
  margin-left: auto;
  font-size: 22rpx;
  color: #8b7e68;
}

.msg-card__unread {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #a33b2b;
  flex: none;
}

.msg-card__title {
  display: block;
  margin-top: 8rpx;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.4;
}

.msg-card__body {
  display: block;
  margin-top: 4rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #635846;
}

.msg-card__action {
  display: block;
  margin-top: 10rpx;
  font-size: 23rpx;
  color: #873023;
}

.msg-empty {
  padding-top: 12rpx;
}

.msg-bottom {
  height: calc(48rpx + env(safe-area-inset-bottom));
}

.msg-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding-top: 20rpx;
  padding-bottom: 12rpx;
}

.msg-toolbar__count {
  font-size: 24rpx;
  color: #635846;
}

.msg-toolbar__read {
  font-size: 24rpx;
  color: #873023;
}

.msg-card__body {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* ===== VOLT TRAINING LOG / MESSAGES ===== */

.msg-scroll {
  background: transparent;
}

.msg-toolbar {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  padding: 22rpx 32rpx 12rpx;
  border-bottom: 1rpx solid #d9cbb6;
}

.msg-toolbar__count {
  font-family: "Plex Mono", Consolas, monospace;
  font-size: 20rpx;
  color: #635846;
}

.msg-toolbar__read {
  flex: none;
  padding-bottom: 2rpx;
  border-bottom: 1rpx solid rgba(163, 59, 43, 0.42);
  color: #a33b2b;
  font-size: 21rpx;
}

.msg-list {
  margin-top: 16rpx;
}

.msg-card {
  position: relative;
  margin-bottom: 14rpx;
  padding: 20rpx;
  border: 1rpx solid rgba(27, 23, 18, 0.18);
  border-radius: 4rpx;
  background: #fdf9f0;
  box-shadow: 0 6rpx 16rpx rgba(27, 23, 18, 0.03);
}

.msg-card.is-read {
  opacity: 0.7;
}

.msg-card--hover {
  background: #fbf5e9;
}

.msg-card__top {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.msg-card__type {
  font-family: "Plex Mono", Consolas, monospace;
  font-size: 18rpx;
  color: #a33b2b;
}

.msg-card__time {
  margin-left: auto;
  font-family: "Plex Mono", Consolas, monospace;
  font-size: 17rpx;
  color: #72654f;
}

.msg-card__unread {
  width: 10rpx;
  height: 10rpx;
  flex: none;
  background: #a33b2b;
}

.msg-card__title {
  display: block;
  margin-top: 8rpx;
  font-family: "Source Han Serif SC", "Noto Serif CJK SC", "Songti SC", "STSong", "SimSun", serif;
  font-size: 31rpx;
  font-weight: 700;
  line-height: 1.35;
  color: #1b1712;
}

.msg-card__body {
  display: block;
  margin-top: 4rpx;
  font-size: 23rpx;
  line-height: 1.6;
  color: #635846;
}

.msg-empty {
  margin-top: 22rpx;
}

.msg-bottom {
  height: calc(40rpx + env(safe-area-inset-bottom));
}
