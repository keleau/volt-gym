.invite-page {
  height: 100vh;
  overflow: hidden;
  background: #f8f2e6;
}

.invite-scroll {
  width: 100%;
  height: 100vh;
}

.invite-hero {
  padding-left: 32rpx;
  padding-right: 32rpx;
  padding-bottom: 84rpx;
  background: #a33b2b;
  border-radius: 0 0 40rpx 40rpx;
}

.invite-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding-top: 12rpx;
}

.invite-brand {
  font-family: "Source Han Serif SC", "Noto Serif CJK SC", "Songti SC", "STSong", "SimSun", serif;
  font-size: 40rpx;
  line-height: 1;
  color: #1b1712;
}

.invite-brand__slash {
  color: #1b1712;
  opacity: 0.45;
  letter-spacing: -0.14em;
  margin-left: 4rpx;
  transform: skewX(-8deg);
}

.invite-top__actions {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.invite-share {
  width: auto !important;
  height: 50rpx;
  padding: 0 16rpx;
  border-radius: 4rpx;
  background: rgba(253, 249, 240, 0.35);
  color: #1b1712;
  font-size: 23rpx;
  line-height: 50rpx;
}

.invite-share--hover {
  background: rgba(253, 249, 240, 0.55);
}

.invite-close {
  position: relative;
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  background: rgba(253, 249, 240, 0.35);
}

.invite-close--hover {
  background: rgba(253, 249, 240, 0.55);
}

.invite-close__line {
  position: absolute;
  top: 24rpx;
  left: 14rpx;
  width: 22rpx;
  height: 2rpx;
  background: #1b1712;
  transform: rotate(45deg);
}

.invite-close__line--two {
  transform: rotate(-45deg);
}

.invite-copy {
  padding-top: 38rpx;
}

.invite-eyebrow {
  font-size: 24rpx;
  color: rgba(27, 23, 18, 0.6);
}

.invite-title {
  display: flex;
  flex-direction: column;
  margin-top: 8rpx;
  font-size: 62rpx;
  font-weight: 800;
  letter-spacing: -0.05em;
  line-height: 1.14;
  color: #1b1712;
}

.invite-title__hl {
  display: inline-block;
  margin-right: 6rpx;
  padding: 0 14rpx;
  border-radius: 2rpx;
  background: #fdf9f0;
  color: #873023;
}

.invite-from {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: rgba(27, 23, 18, 0.66);
}

.invite-from__dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: rgba(27, 23, 18, 0.5);
}

.invite-self {
  display: block;
  margin-top: 6rpx;
  font-size: 23rpx;
  color: rgba(27, 23, 18, 0.45);
}

.invite-loading {
  padding: 40rpx 32rpx;
}

.invite-error {
  padding-top: 20rpx;
}

.invite-body {
  position: relative;
  margin-top: -46rpx;
  padding: 0 32rpx;
}

.invite-program {
  overflow: hidden;
}

.invite-program__img {
  width: 100%;
  height: 280rpx;
  object-fit: cover;
  background: #f8f2e6;
}

.invite-program__info {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
  padding: 20rpx 22rpx 22rpx;
}

.invite-program__en {
  font-size: 23rpx;
  color: #873023;
  letter-spacing: 0.04em;
}

.invite-program__name {
  font-size: 36rpx;
  font-weight: 800;
  letter-spacing: -0.03em;
}

.invite-program__desc {
  margin-top: 2rpx;
  font-size: 24rpx;
  line-height: 1.55;
  color: #635846;
}

.invite-program__meta {
  margin-top: 4rpx;
  font-size: 23rpx;
  color: #635846;
}

.invite-offer {
  margin-top: 14rpx;
  padding: 24rpx;
}

.invite-offer__top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.invite-offer__label {
  display: block;
  font-size: 23rpx;
  color: #635846;
}

.invite-offer__price {
  display: flex;
  align-items: flex-start;
  gap: 2rpx;
  margin-top: 2rpx;
}

.invite-offer__currency {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #873023;
}

.invite-offer__num {
  font-family: "Source Han Serif SC", "Noto Serif CJK SC", "Songti SC", "STSong", "SimSun", serif;
  font-size: 64rpx;
  line-height: 0.95;
  color: #1b1712;
}

.invite-offer__title {
  display: block;
  margin-top: 8rpx;
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: -0.02em;
}

.invite-benefits {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8rpx 14rpx;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #ece0ce;
}

.invite-benefit {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 23rpx;
  color: #3c342a;
  line-height: 1.4;
}

.invite-benefit__check {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: #f0ddd6;
  color: #873023;
  font-size: 22rpx;
  flex: none;
}

.invite-offer__btn {
  margin-top: 20rpx;
}

.invite-offer__note {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #8b7e68;
  text-align: center;
}

.invite-features {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 6rpx;
}

.invite-feature {
  position: relative;
  font-size: 23rpx;
  color: #635846;
}

.invite-feature + .invite-feature::before {
  content: "";
  position: absolute;
  left: -32rpx;
  top: 50%;
  width: 3rpx;
  height: 20rpx;
  margin-top: -10rpx;
  border-radius: 4rpx;
  background: #d9d1c4;
}

.invite-foot {
  padding-top: 16rpx;
}

.invite-foot__brand {
  font-family: "Source Han Serif SC", "Noto Serif CJK SC", "Songti SC", "STSong", "SimSun", serif;
  font-size: 32rpx;
  line-height: 1;
  color: #1b1712;
}

.invite-foot__slash {
  color: #a33b2b;
  letter-spacing: -0.14em;
  margin-left: 3rpx;
  transform: skewX(-8deg);
}

.invite-foot__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 10rpx;
  font-size: 23rpx;
  color: #635846;
}

.invite-foot__phone {
  color: #873023;
}

.invite-foot__note {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #8b7e68;
}

.invite-bottom {
  height: calc(40rpx + env(safe-area-inset-bottom));
}

