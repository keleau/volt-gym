.events-page {
  height: 100vh;
  overflow: hidden;
}

.events-scroll {
  width: 100%;
  height: 100vh;
}

.events-head {
  padding-top: 26rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #d9cbb6;
}

.events-kicker {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 20rpx;
  letter-spacing: 0.08em;
  color: #635846;
}

.events-kicker__node {
  width: 12rpx;
  height: 12rpx;
  background: #a33b2b;
}

.events-title {
  display: block;
  margin-top: 8rpx;
  font-family: "Source Han Serif SC", "Noto Serif CJK SC", "Songti SC", "STSong", "SimSun", serif;
  font-size: 54rpx;
  font-weight: 700;
  letter-spacing: 0.01em;
  line-height: 1.2;
  color: #1b1712;
}

.events-sub {
  display: block;
  margin-top: 5rpx;
  font-size: 24rpx;
  line-height: 1.55;
  color: #635846;
}

.events-current {
  margin-top: 18rpx;
}

.events-list {
  padding-top: 20rpx;
}

.event-ticket {
  display: flex;
  gap: 18rpx;
  margin-bottom: 16rpx;
  padding: 20rpx;
  border: 1rpx solid rgba(27, 23, 18, 0.2);
  border-radius: 4rpx;
  background: #fdf9f0;
  box-shadow: 0 8rpx 18rpx rgba(27, 23, 18, 0.04);
}

.event-ticket__date {
  width: 78rpx;
  flex: none;
  align-self: flex-start;
  padding-right: 14rpx;
  border-right: 1rpx solid #d9cbb6;
  text-align: center;
}

.event-ticket__day {
  display: block;
  font-family: "Source Han Serif SC", "Noto Serif CJK SC", "Songti SC", "STSong", "SimSun", serif;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.05;
  color: #a33b2b;
}

.event-ticket__month {
  display: block;
  margin-top: 4rpx;
  font-size: 18rpx;
  color: #72654f;
}

.event-ticket__main {
  flex: 1;
  min-width: 0;
}

.event-ticket__title-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12rpx;
}

.event-ticket__title {
  font-family: "Source Han Serif SC", "Noto Serif CJK SC", "Songti SC", "STSong", "SimSun", serif;
  font-size: 33rpx;
  font-weight: 700;
  color: #1b1712;
}

.event-ticket__status {
  flex: none;
  font-size: 18rpx;
  color: #873023;
}

.event-ticket__meta,
.event-ticket__desc {
  display: block;
  margin-top: 3rpx;
  font-size: 21rpx;
  line-height: 1.5;
  color: #635846;
}

.event-ticket__desc {
  margin-top: 6rpx;
}

.event-ticket__foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 12rpx;
  padding-top: 10rpx;
  border-top: 1rpx dashed #d9cbb6;
}

.event-ticket__count {
  font-size: 18rpx;
  color: #72654f;
}

.event-ticket__btn {
  width: auto !important;
  min-width: 104rpx;
  height: 56rpx;
  padding: 0 14rpx;
  border: 1rpx solid #a33b2b;
  border-radius: 2rpx;
  background: #a33b2b;
  color: #fbf5e9;
  font-size: 21rpx;
  line-height: 54rpx;
}

.event-ticket__btn.is-joined {
  border-color: #d9cbb6;
  background: #efe4d2;
  color: #635846;
}

.events-bottom {
  height: calc(40rpx + env(safe-area-inset-bottom));
}
