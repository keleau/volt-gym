.calendar-page {
  height: 100vh;
  overflow: hidden;
}

.calendar-scroll {
  width: 100%;
  height: 100vh;
}

.calendar-head {
  padding-top: 26rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #d9cbb6;
}

.calendar-kicker {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 20rpx;
  letter-spacing: 0.06em;
  color: #635846;
}

.calendar-kicker__node {
  width: 12rpx;
  height: 12rpx;
  background: #a33b2b;
}

.calendar-title {
  display: block;
  margin-top: 8rpx;
  font-family: "Source Han Serif SC", "Noto Serif CJK SC", "Songti SC", "STSong", "SimSun", serif;
  font-size: 54rpx;
  font-weight: 700;
  letter-spacing: 0.01em;
  line-height: 1.2;
  color: #1b1712;
}

.calendar-sub {
  display: block;
  margin-top: 5rpx;
  font-size: 24rpx;
  line-height: 1.55;
  color: #635846;
}

.calendar-current {
  margin-top: 18rpx;
}

.calendar-card {
  margin-top: 22rpx;
}

.calendar-card .cal {
  padding: 22rpx;
  border: 1rpx solid rgba(27, 23, 18, 0.18);
  border-radius: 4rpx;
  background: #fdf9f0;
  box-shadow: 0 8rpx 20rpx rgba(27, 23, 18, 0.04);
}

.calendar-legend {
  display: flex;
  align-items: center;
  gap: 22rpx;
  margin-top: 14rpx;
  padding: 0 4rpx;
  font-size: 19rpx;
  color: #72654f;
}

.calendar-key {
  display: flex;
  align-items: center;
  gap: 7rpx;
}

.calendar-mark,
.calendar-today,
.calendar-selected {
  width: 14rpx;
  height: 14rpx;
  border: 1rpx solid #66705b;
  background: #e3e7da;
}

.calendar-today {
  border-color: #a33b2b;
  background: transparent;
}

.calendar-selected {
  border-color: #a33b2b;
  background: #f0ddd6;
}

.day-detail {
  margin-top: 26rpx;
}

.day-detail__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  padding-bottom: 10rpx;
  border-bottom: 1rpx solid #d9cbb6;
}

.day-detail__date {
  font-family: "Source Han Serif SC", "Noto Serif CJK SC", "Songti SC", "STSong", "SimSun", serif;
  font-size: 34rpx;
  font-weight: 700;
  color: #1b1712;
}

.day-detail__clear {
  color: #a33b2b;
  font-size: 21rpx;
  border-bottom: 1rpx solid rgba(163, 59, 43, 0.42);
}

.day-list {
  margin-top: 8rpx;
}

.day-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx dashed #d9cbb6;
}

.day-row__mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34rpx;
  height: 34rpx;
  flex: none;
  background: #66705b;
  color: #fbf5e9;
  font-size: 20rpx;
}

.day-row__main {
  flex: 1;
  min-width: 0;
}

.day-row__name {
  display: block;
  font-family: "Source Han Serif SC", "Songti SC", "STSong", "SimSun", serif;
  font-size: 28rpx;
  font-weight: 700;
  color: #1b1712;
}

.day-row__meta {
  display: block;
  margin-top: 2rpx;
  font-size: 20rpx;
  color: #635846;
}

.day-row__side {
  flex: none;
  text-align: right;
}

.day-row__kcal {
  display: block;
  font-size: 24rpx;
  color: #873023;
}

.day-row__unit {
  display: block;
  font-family: "Plex Mono", Consolas, monospace;
  font-size: 15rpx;
  color: #72654f;
}

.day-empty {
  padding: 28rpx 0;
  text-align: center;
}

.day-empty__title {
  display: block;
  font-family: "Source Han Serif SC", "Songti SC", "SimSun", serif;
  font-size: 28rpx;
  font-weight: 700;
  color: #1b1712;
}

.day-empty__desc {
  display: block;
  margin-top: 4rpx;
  font-size: 21rpx;
  color: #72654f;
}

.calendar-hint {
  margin-top: 26rpx;
  padding: 20rpx 0;
  border-top: 1rpx dashed #d9cbb6;
  border-bottom: 1rpx dashed #d9cbb6;
}

.calendar-hint__serif {
  display: block;
  font-family: "STSong", "Songti SC", "SimSun", serif;
  font-size: 25rpx;
  color: #635846;
}

.calendar-hint__mono {
  display: block;
  margin-top: 5rpx;
  font-size: 18rpx;
  color: #a33b2b;
}

.calendar-bottom {
  height: calc(40rpx + env(safe-area-inset-bottom));
}
