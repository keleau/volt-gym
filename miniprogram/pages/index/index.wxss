.home {
  height: 100vh;
  overflow: hidden;
  background: transparent;
}

.home-scroll {
  width: 100%;
  height: 100vh;
}

/* ---------- loading / error ---------- */

.home-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 220rpx;
}

.home-loading__logo {
  font-family: "Source Han Serif SC", "Noto Serif CJK SC", "Songti SC", "STSong", "SimSun", serif;
  font-size: 88rpx;
  font-weight: 700;
  letter-spacing: 0.05em;
  line-height: 1;
  color: #1b1712;
}

.home-loading__logo .accent {
  color: #a33b2b;
}

.home-error {
  padding-top: 36rpx;
}

/* ---------- header ---------- */

.home-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  padding-top: 22rpx;
  padding-bottom: 22rpx;
  border-bottom: 1rpx solid #d9cbb6;
}

.home-head__main {
  flex: 1;
  min-width: 0;
}

.home-kicker {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 20rpx;
  letter-spacing: 0.08em;
  color: #635846;
}

.home-kicker__node {
  width: 12rpx;
  height: 12rpx;
  background: #a33b2b;
  flex: none;
}

.home-greet {
  margin-top: 10rpx;
  font-family: "Source Han Serif SC", "Noto Serif CJK SC", "Songti SC", "STSong", "SimSun", serif;
  font-size: 50rpx;
  font-weight: 700;
  letter-spacing: 0.005em;
  line-height: 1.22;
  color: #1b1712;
}

.home-lede {
  margin-top: 6rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #635846;
}

.home-lede .accent {
  color: #a33b2b;
  font-weight: 600;
}

.home-bell {
  position: relative;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border: 1rpx solid #c9b99f;
  border-radius: 2rpx;
  background: #fdf9f0;
}

.home-bell--hover {
  background: #efe4d2;
}

.bell {
  position: relative;
  width: 24rpx;
  height: 26rpx;
  border: 3rpx solid #1b1712;
  border-radius: 13rpx 13rpx 5rpx 5rpx;
}

.bell::before {
  content: "";
  position: absolute;
  top: -8rpx;
  left: 7rpx;
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: #1b1712;
}

.bell__clapper {
  position: absolute;
  left: 50%;
  bottom: -7rpx;
  width: 8rpx;
  height: 3rpx;
  margin-left: -4rpx;
  background: #1b1712;
}

.home-bell__badge {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 6rpx;
  border: 1rpx solid #1b1712;
  border-radius: 0;
  background: #a33b2b;
  color: #fbf5e9;
  font-size: 18rpx;
  line-height: 30rpx;
  text-align: center;
}

.home-current {
  padding-top: 16rpx;
  padding-bottom: 4rpx;
}

/* ---------- today card ---------- */

.home-next {
  padding-top: 20rpx;
}

.today-card {
  position: relative;
  padding: 26rpx;
  border: 1rpx solid rgba(27, 23, 18, 0.22);
  border-radius: 4rpx;
  background: #fdf9f0;
  box-shadow: 0 10rpx 24rpx rgba(27, 23, 18, 0.055);
}

.today-top {
  display: flex;
  align-items: flex-start;
  gap: 22rpx;
}

.today-info {
  flex: 1;
  min-width: 0;
}

.today-label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.today-label {
  font-size: 20rpx;
  letter-spacing: 0.08em;
  color: #635846;
}

.today-status {
  flex: none;
  font-size: 20rpx;
  letter-spacing: 0.04em;
  color: #56604c;
}

.today-status::before {
  content: "";
  display: inline-block;
  width: 8rpx;
  height: 8rpx;
  margin-right: 7rpx;
  background: #66705b;
  transform: translateY(-1rpx);
}

.today-status.is-lock {
  color: #a33b2b;
}

.today-status.is-lock::before {
  background: #a33b2b;
}

.today-title {
  margin-top: 8rpx;
  font-family: "Source Han Serif SC", "Noto Serif CJK SC", "Songti SC", "STSong", "SimSun", serif;
  font-size: 46rpx;
  font-weight: 700;
  letter-spacing: 0.01em;
  line-height: 1.22;
  color: #1b1712;
}

.today-meta {
  margin-top: 6rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #635846;
}

.today-time-row {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 8rpx 14rpx;
  margin-top: 12rpx;
}

.today-time {
  font-family: "Source Han Serif SC", "Noto Serif CJK SC", "Songti SC", "STSong", "SimSun", serif;
  font-size: 64rpx;
  font-weight: 700;
  letter-spacing: 0.02em;
  line-height: 0.94;
  color: #1b1712;
}

.today-date {
  padding-bottom: 4rpx;
  font-size: 21rpx;
  color: #635846;
}

.today-photo {
  position: relative;
  width: 174rpx;
  height: 212rpx;
  flex: none;
  padding: 8rpx;
  background: #fffaf0;
  border: 1rpx solid rgba(27, 23, 18, 0.2);
  box-shadow: 0 8rpx 18rpx rgba(27, 23, 18, 0.09);
  transform: rotate(1deg);
}

.today-photo__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.today-photo__code {
  position: absolute;
  left: 8rpx;
  bottom: 8rpx;
  padding: 4rpx 8rpx;
  background: #a33b2b;
  color: #fbf5e9;
  font-size: 17rpx;
  letter-spacing: 0.06em;
}

.today-entry {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 20rpx;
  padding: 14rpx 16rpx;
  border: 1rpx dashed #c6b69e;
  background: #fbf5e9;
}

.today-entry--hover {
  background: #f2e8d8;
}

.today-entry__label {
  flex: none;
  font-size: 18rpx;
  letter-spacing: 0.06em;
  color: #72654f;
}

.today-entry__code {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  font-size: 26rpx;
  color: #1b1712;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.today-entry__arrow {
  flex: none;
  font-size: 30rpx;
  line-height: 1;
  color: #a33b2b;
}

.today-lock {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 16rpx;
  padding: 12rpx 14rpx;
  border: 1rpx solid #dfc3b9;
  background: #f0ddd6;
  color: #873023;
  font-size: 23rpx;
  font-weight: 600;
}

.today-lock .mono {
  font-size: 18rpx;
  letter-spacing: 0.08em;
  font-weight: 400;
  opacity: 0.75;
}

.today-card .dot-divider {
  margin: 20rpx 0 16rpx;
}

.today-actions {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.today-btn {
  width: 100% !important;
  min-height: 86rpx;
  margin: 0 !important;
  justify-content: space-between;
  padding: 0 24rpx;
  font-family: "Source Han Serif SC", "Noto Serif CJK SC", "Songti SC", "STSong", "SimSun", serif;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 0.02em;
}

.today-btn__arrow {
  font-family: "Plex Mono", "SFMono-Regular", Consolas, monospace;
  font-size: 32rpx;
  font-weight: 400;
}

/* ---------- member pass ticket ---------- */

.home-pass {
  margin-top: 30rpx;
}

.pass-ticket {
  position: relative;
  padding: 22rpx 24rpx 18rpx 30rpx;
  border: 1rpx solid rgba(27, 23, 18, 0.22);
  border-radius: 4rpx;
  background: #fdf9f0;
  box-shadow: 0 10rpx 24rpx rgba(27, 23, 18, 0.05);
}

.pass-ticket::before {
  content: "";
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  width: 6rpx;
  background: #a33b2b;
}

.pass-ticket--hover {
  background: #fbf5e9;
}

.pass-ticket__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.pass-ticket__label {
  font-size: 19rpx;
  letter-spacing: 0.08em;
  color: #72654f;
}

.pass-ticket__stamp {
  padding: 3rpx 10rpx;
  border: 1rpx solid #a33b2b;
  color: #a33b2b;
  font-size: 16rpx;
  letter-spacing: 0.08em;
  transform: rotate(-4deg);
}

.pass-ticket__main {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24rpx;
  margin-top: 10rpx;
}

.pass-credits {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  flex: none;
}

.pass-credits__num {
  font-family: "Source Han Serif SC", "Noto Serif CJK SC", "Songti SC", "STSong", "SimSun", serif;
  font-size: 92rpx;
  font-weight: 700;
  letter-spacing: -0.02em;
  line-height: 0.9;
  color: #1b1712;
}

.pass-credits__unit {
  font-size: 21rpx;
  color: #635846;
}

.pass-ticket__meta {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
  padding-bottom: 4rpx;
  text-align: right;
}

.pass-ticket__plan {
  font-family: "Source Han Serif SC", "Noto Serif CJK SC", "Songti SC", "STSong", "SimSun", serif;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.3;
  color: #1b1712;
}

.pass-ticket__expire {
  font-size: 18rpx;
  color: #72654f;
}

.pass-punches {
  display: flex;
  gap: 6rpx;
  margin-top: 16rpx;
}

.pass-punch {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 30rpx;
  border: 1rpx dashed #c6b69e;
  background: #fbf5e9;
}

.pass-punch.is-used {
  border-style: solid;
  border-color: #66705b;
  background: #66705b;
}

.pass-punch__check {
  font-size: 17rpx;
  line-height: 1;
  color: #fbf5e9;
}

.pass-ticket__foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 14rpx;
  padding-top: 12rpx;
  border-top: 1rpx dashed #d9cbb6;
  font-size: 19rpx;
  color: #72654f;
}

.pass-ticket__link {
  flex: none;
  color: #a33b2b;
  font-size: 20rpx;
}

/* ---------- home sections ---------- */

.home-section {
  margin-top: 44rpx;
}

.home-section__head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 14rpx;
}

.home-section__main {
  flex: 1;
  min-width: 0;
}

.home-section__kicker {
  display: block;
  font-size: 18rpx;
  letter-spacing: 0.07em;
  color: #72654f;
}

.home-section__title {
  display: block;
  margin-top: 4rpx;
  font-family: "Source Han Serif SC", "Noto Serif CJK SC", "Songti SC", "STSong", "SimSun", serif;
  font-size: 38rpx;
  font-weight: 700;
  letter-spacing: 0.005em;
  line-height: 1.25;
  color: #1b1712;
}

.home-section__link {
  flex: none;
  padding-bottom: 3rpx;
  border-bottom: 1rpx solid rgba(163, 59, 43, 0.38);
  color: #a33b2b;
  font-size: 21rpx;
}

/* ---------- community ---------- */

.home-challenge {
  padding: 20rpx 22rpx;
  border: 1rpx solid #dfc3b9;
  border-radius: 4rpx;
  background: #fbf5e9;
}

.home-challenge--hover {
  background: #f2e8d8;
}

.home-challenge__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.home-challenge__title {
  font-family: "Source Han Serif SC", "Noto Serif CJK SC", "Songti SC", "STSong", "SimSun", serif;
  font-size: 31rpx;
  font-weight: 700;
  line-height: 1.3;
  color: #1b1712;
}

.home-challenge__tag {
  flex: none;
  font-size: 17rpx;
  color: #873023;
}

.home-challenge__desc {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  line-height: 1.55;
  color: #635846;
}

.home-challenge__progress {
  height: 8rpx;
  margin-top: 14rpx;
  background: rgba(163, 59, 43, 0.14);
  overflow: hidden;
}

.home-challenge__bar {
  height: 100%;
  background: #a33b2b;
}

.home-challenge__foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 10rpx;
  font-size: 20rpx;
  color: #635846;
}

.home-challenge__cta {
  flex: none;
  color: #a33b2b;
  font-size: 18rpx;
}

.home-event {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 12rpx;
  padding: 18rpx;
  border: 1rpx solid rgba(27, 23, 18, 0.18);
  border-radius: 4rpx;
  background: #fdf9f0;
}

.home-event--hover {
  background: #fbf5e9;
}

.home-event__date {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 86rpx;
  flex: none;
  padding-right: 16rpx;
  border-right: 1rpx dashed #d9cbb6;
}

.home-event__day {
  font-family: "Source Han Serif SC", "Noto Serif CJK SC", "Songti SC", "STSong", "SimSun", serif;
  font-size: 46rpx;
  font-weight: 700;
  letter-spacing: 0.01em;
  line-height: 0.9;
  color: #1b1712;
}

.home-event__month {
  margin-top: 4rpx;
  font-size: 15rpx;
  letter-spacing: 0.08em;
  color: #a33b2b;
}

.home-event__main {
  flex: 1;
  min-width: 0;
}

.home-event__kicker {
  display: block;
  font-size: 16rpx;
  letter-spacing: 0.05em;
  color: #72654f;
}

.home-event__title {
  display: block;
  margin-top: 2rpx;
  font-family: "Source Han Serif SC", "Noto Serif CJK SC", "Songti SC", "STSong", "SimSun", serif;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.3;
  color: #1b1712;
}

.home-event__meta {
  display: block;
  margin-top: 3rpx;
  font-size: 20rpx;
  color: #635846;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.home-event__side {
  flex: none;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.home-event__status {
  padding: 3rpx 8rpx;
  border: 1rpx solid #dfc3b9;
  background: #f0ddd6;
  color: #873023;
  font-size: 16rpx;
  white-space: nowrap;
}

.home-event__status.is-full {
  border-color: #d9cbb6;
  background: #efe4d2;
  color: #72654f;
}

.home-event__arrow {
  color: #a33b2b;
  font-size: 24rpx;
  line-height: 1;
}



.home-bottom {
  height: calc(180rpx + env(safe-area-inset-bottom));
}

/* ---------- entry sheet ---------- */

.entry-sheet {
  padding-top: 4rpx;
}

.entry-pass {
  position: relative;
  padding: 24rpx;
  border: 1rpx solid rgba(27, 23, 18, 0.22);
  background: #fdf9f0;
  overflow: hidden;
}

.entry-pass::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 6rpx;
  background: #a33b2b;
}

.entry-pass__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  padding-top: 6rpx;
}

.entry-pass__label {
  font-size: 19rpx;
  letter-spacing: 0.06em;
  color: #635846;
}

.entry-pass__status {
  padding: 6rpx 10rpx;
  border: 1rpx solid #a33b2b;
  color: #a33b2b;
  font-size: 18rpx;
  letter-spacing: 0.06em;
  transform: rotate(-4deg);
}

.entry-pass__code {
  margin-top: 18rpx;
  font-family: "Source Han Serif SC", "Noto Serif CJK SC", "Songti SC", "STSong", "SimSun", serif;
  font-size: 64rpx;
  font-weight: 700;
  letter-spacing: 0.04em;
  line-height: 1.1;
  color: #1b1712;
  overflow-wrap: break-word;
}

.entry-pass__barcode {
  height: 64rpx;
  margin-top: 20rpx;
  background-image: repeating-linear-gradient(
    90deg,
    #1b1712 0,
    #1b1712 4rpx,
    transparent 4rpx,
    transparent 10rpx,
    #1b1712 10rpx,
    #1b1712 15rpx,
    transparent 15rpx,
    transparent 22rpx,
    #1b1712 22rpx,
    #1b1712 24rpx,
    transparent 24rpx,
    transparent 34rpx
  );
  opacity: 0.82;
}

.entry-pass__meta {
  margin-top: 18rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #3c342a;
}

.entry-sheet__hint {
  display: block;
  margin: 16rpx 0 22rpx;
  font-size: 24rpx;
  line-height: 1.65;
  color: #635846;
}

.entry-sheet__btn {
  width: 100% !important;
  min-height: 90rpx;
  justify-content: space-between;
  padding: 0 24rpx;
  font-family: "Source Han Serif SC", "Songti SC", "SimSun", serif;
  font-size: 30rpx;
  font-weight: 700;
}

.entry-sheet__safe {
  height: calc(20rpx + env(safe-area-inset-bottom));
}

@media (max-width: 350px) {
  .home-greet {
    font-size: 46rpx;
  }

  .today-time {
    font-size: 58rpx;
  }

  .today-photo {
    width: 156rpx;
    height: 196rpx;
  }

  .pass-credits__num {
    font-size: 80rpx;
  }

  .pass-punch {
    height: 26rpx;
  }

  .home-event__date {
    width: 78rpx;
  }

  .home-event__title {
    font-size: 26rpx;
  }
}

