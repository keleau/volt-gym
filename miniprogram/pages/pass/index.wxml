<view class="page pass-page">
  <volt-nav placeholder="{{false}}" back="{{true}}" title="会员卡"></volt-nav>

  <scroll-view class="pass-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view style="height:{{nav.totalHeight}}px"></view>

    <view wx:if="{{loading}}" class="loading"><view class="loading__bar"></view><text>正在读取会员卡</text></view>

    <block wx:else>
      <view class="pass-head wrap">
        <view class="pass-kicker mono"><view class="pass-kicker__node"></view>VOLT / PASS · 按次通电</view>
        <text class="pass-title serif">会员卡</text>
        <text class="pass-sub">不办年卡，用一次算一次。</text>
        <view class="pass-current"><view class="current-line"></view></view>
      </view>

      <view class="pass-ticket-wrap wrap">
        <view class="pass-ticket">
          <span class="tape tape--left"></span>
          <span class="tape tape--right"></span>
          <view class="pass-ticket__top">
            <view class="pass-brand serif">VOLT<text class="pass-brand__slash">///</text></view>
            <text class="pass-valid mono">VALID / 有效</text>
          </view>
          <view class="pass-ticket__main">
            <view class="pass-credits">
              <text class="pass-credits__num serif">{{pendingCard && !member.credits ? '待' : member.credits}}</text>
              <text class="pass-credits__unit">{{pendingCard && !member.credits ? '开卡' : '次可用'}}</text>
            </view>
            <text class="pass-plan serif">{{pendingCard && !member.credits ? pendingCard.planName : member.planName}}</text>
            <text wx:if="{{pendingCard && !member.credits}}" class="pass-expire mono">到店付款后生效</text>
            <text wx:else class="pass-expire mono">有效至 {{member.expiresAt}}</text>
            <view wx:if="{{pendingCard}}" class="pass-pending">
              <text class="pass-pending__label mono">PENDING / 待开卡</text>
              <text class="pass-pending__name">{{pendingCard.planName}} · {{pendingCard.credits}} 次</text>
              <text class="pass-pending__hint">到店付款后由店员开卡，次数自动到账</text>
              <button
                wx:if="{{demoPayEnabled}}"
                class="pass-demo-pay"
                bindtap="onDemoPay"
                disabled="{{paying}}"
              >
                {{paying ? '演示支付中…' : '演示支付并开卡'}}
              </button>
              <text wx:if="{{demoPayEnabled}}" class="pass-demo-note">演示用 · 不会真实扣款</text>
            </view>
          </view>
          <view wx:if="{{passCells.length}}" class="pass-grid">
            <view
              wx:for="{{passCells}}"
              wx:key="no"
              class="pass-cell {{item.used ? 'is-used' : ''}}"
            >
              <text wx:if="{{item.used}}" class="pass-cell__check">✓</text>
              <text wx:else class="pass-cell__num mono">{{item.label}}</text>
            </view>
          </view>
          <view wx:else class="pass-empty">{{!member.phoneBound ? '绑定手机号后同步官网购卡和次卡。' : pendingCard ? '购卡已登记，到店付款后开卡。' : '暂无次卡，点下方方案登记购卡。'}}</view>
          <view class="pass-ticket__foot">
            <text class="mono">已用 {{member.creditsTotal - member.credits}} / {{member.creditsTotal}} · 余 {{member.credits}} 次</text>
            <view class="pass-barcode"></view>
          </view>
        </view>
      </view>

      <view wx:if="{{trial.free && trial.available}}" class="pass-gift wrap">
        <view class="pass-gift__main">
          <text class="pass-gift__kicker mono">MEMBER GIFT / 会员赠课</text>
          <text class="pass-gift__title serif">含 1 次免费体验课</text>
          <text class="pass-gift__desc">随卡赠送 · 不扣次卡 · 每个手机号限一次</text>
        </view>
        <button class="btn btn--primary pass-gift__btn" bindtap="goTrial">去预约</button>
      </view>

      <view class="pass-plans wrap">
        <view class="pass-section-head">
          <text class="pass-section-title serif">次卡选项</text>
          <text class="pass-section-aside mono">PLANS / 按次</text>
        </view>
        <volt-plan-picker
          plans="{{plans}}"
          current-code="{{member.planCode}}"
          bind:select="onPickPlan"
        ></volt-plan-picker>
        <button class="btn btn--ghost btn--block pass-contact" bindtap="onContact">联系前台购卡</button>
        <text class="pass-note">按次购卡 · 前台办理 · 官网或小程序登记的购卡单开卡后都会显示在这里</text>
      </view>

      <view class="pass-ledger wrap">
        <view class="pass-section-head">
          <text class="pass-section-title serif">次卡流水</text>
          <text class="pass-section-aside mono">LEDGER / 最近 {{ledgerEntries.length}} 条</text>
        </view>
        <view wx:if="{{ledgerEntries.length}}" class="ledger-list">
          <view wx:for="{{ledgerEntries}}" wx:key="id" class="ledger-row">
            <view class="ledger-row__main">
              <text class="ledger-row__label">{{item.label}}</text>
              <text class="ledger-row__date mono">{{item.date}}</text>
            </view>
            <view class="ledger-row__right">
              <text class="ledger-row__change {{item.positive ? 'is-plus' : 'is-minus'}}">{{item.change}}</text>
              <text class="ledger-row__balance mono">余 {{item.balance}}</text>
            </view>
          </view>
        </view>
        <view wx:else class="pass-empty">还没有次卡流水。</view>
      </view>

      <view class="pass-bottom"></view>
    </block>
  </scroll-view>

  <volt-sheet
    visible="{{buySheetVisible}}"
    title="登记购卡"
    subtitle="到店付款后由店员开卡"
    maxHeight="78vh"
    bind:close="closeBuySheet"
  >
    <view wx:if="{{buyPlan}}" class="buy-sheet">
      <view class="buy-plan">
        <view class="buy-plan__main">
          <text class="buy-plan__label mono">SELECTED / 已选</text>
          <text class="buy-plan__name serif">{{buyPlan.name}}</text>
        </view>
        <view class="buy-plan__right">
          <text class="buy-plan__price serif">¥{{buyPlan.price}}</text>
          <text class="buy-plan__unit">{{buyPlan.unit}}</text>
        </view>
      </view>

      <view class="buy-field">
        <text class="buy-field__label">开卡门店</text>
        <picker mode="selector" range="{{venues}}" range-key="name" bindchange="onVenueChange">
          <view class="buy-field__value">
            <text>{{buyVenueName || '选择到店付款的门店'}}</text>
            <text class="buy-field__arrow">›</text>
          </view>
        </picker>
      </view>

      <text wx:if="{{!member.phoneBound}}" class="buy-note is-warn">购卡需要先绑定手机号，提交时会引导去绑定。</text>
      <text class="buy-note">提交后到店付款，店员确认开卡；开卡后次数自动到账，不会在线扣款。</text>
      <button
        class="btn btn--primary btn--block buy-submit"
        bindtap="submitBuy"
        disabled="{{buying}}"
      >
        {{buying ? '提交中…' : '提交购卡登记'}}
      </button>
      <view class="buy-safe"></view>
    </view>
  </volt-sheet>
</view>
