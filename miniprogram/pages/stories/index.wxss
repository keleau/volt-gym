.stories-page {
  height: 100vh;
  overflow: hidden;
}

.stories-scroll {
  width: 100%;
  height: 100vh;
}

.stories-head {
  padding-top: 26rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #d9cbb6;
}

.stories-kicker {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 20rpx;
  letter-spacing: 0.08em;
  color: #635846;
}

.stories-kicker__node {
  width: 12rpx;
  height: 12rpx;
  background: #a33b2b;
}

.stories-title {
  display: block;
  margin-top: 8rpx;
  font-family: "Source Han Serif SC", "Noto Serif CJK SC", "Songti SC", "STSong", "SimSun", serif;
  font-size: 54rpx;
  font-weight: 700;
  letter-spacing: 0.01em;
  line-height: 1.2;
  color: #1b1712;
}

.stories-sub {
  display: block;
  margin-top: 5rpx;
  font-size: 24rpx;
  line-height: 1.55;
  color: #635846;
}

.stories-current {
  margin-top: 18rpx;
}

.lead-wrap {
  position: relative;
  padding-top: 24rpx;
}

.lead-photo {
  position: relative;
  padding: 10rpx;
  background: #fffaf0;
  border: 1rpx solid rgba(27, 23, 18, 0.2);
  box-shadow: 0 12rpx 26rpx rgba(27, 23, 18, 0.08);
  transform: rotate(-0.7deg);
}

.lead-photo__img {
  width: 100%;
  height: 470rpx;
  object-fit: cover;
}

.lead-role {
  margin-top: 18rpx;
  font-size: 18rpx;
  letter-spacing: 0.05em;
  color: #873023;
}

.lead-quote {
  display: block;
  margin-top: 6rpx;
  font-family: "Source Han Serif SC", "Noto Serif CJK SC", "Songti SC", "STSong", "SimSun", serif;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.5;
  color: #1b1712;
}

.lead-name {
  display: block;
  margin-top: 8rpx;
  font-family: "STSong", "Songti SC", "SimSun", serif;
  font-size: 23rpx;
  color: #635846;
  text-align: right;
}

.stories-list {
  margin-top: 34rpx;
}

.stories-section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 14rpx;
  padding-bottom: 9rpx;
  border-bottom: 1rpx solid #d9cbb6;
}

.stories-section-title {
  font-family: "Source Han Serif SC", "Noto Serif CJK SC", "Songti SC", "STSong", "SimSun", serif;
  font-size: 34rpx;
  font-weight: 700;
  color: #1b1712;
}

.stories-section-aside {
  font-size: 18rpx;
  color: #72654f;
}

.story-row {
  display: flex;
  gap: 18rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx dashed #d9cbb6;
}

.story-row__img {
  width: 136rpx;
  height: 160rpx;
  flex: none;
  padding: 6rpx;
  background: #fffaf0;
  border: 1rpx solid rgba(27, 23, 18, 0.16);
  object-fit: cover;
  transform: rotate(-1deg);
}

.story-row__main {
  flex: 1;
  min-width: 0;
}

.story-row__role {
  display: block;
  font-size: 18rpx;
  color: #873023;
}

.story-row__quote {
  display: block;
  margin-top: 5rpx;
  font-family: "Source Han Serif SC", "Songti SC", "STSong", "SimSun", serif;
  font-size: 26rpx;
  line-height: 1.55;
  color: #1b1712;
}

.story-row__name {
  display: block;
  margin-top: 5rpx;
  font-size: 19rpx;
  color: #635846;
}

.stories-empty {
  margin-top: 26rpx;
  padding: 26rpx 0;
  border-top: 1rpx dashed #d9cbb6;
  border-bottom: 1rpx dashed #d9cbb6;
}

.stories-empty__title {
  display: block;
  font-family: "Source Han Serif SC", "Songti SC", "SimSun", serif;
  font-size: 30rpx;
  font-weight: 700;
  color: #1b1712;
}

.stories-empty__desc {
  display: block;
  margin-top: 4rpx;
  font-size: 21rpx;
  color: #72654f;
}

.stories-bottom {
  height: calc(40rpx + env(safe-area-inset-bottom));
}

.lead-photo {
  height: 490rpx;
}

.lead-photo .lead-photo__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
