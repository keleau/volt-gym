# 复制为 .env 后填写本地数据库；.env 不进入版本库
GYM_DB_HOST=localhost
GYM_DB_PORT=3306
GYM_DB_NAME=gym_management_system
GYM_DB_USER=root
GYM_DB_PASSWORD=

# 本地联调短信登录时显示 devCode；生产必须保持 false
VOLT_EXPOSE_OTP=true

# 未配置微信 AppSecret 的本地演示：允许 wx.login 落到种子会员 MBR-DEMO
# 生产必须保持 false，并配置 WX_APP_ID / WX_APP_SECRET
WX_DEMO_FALLBACK=true
WX_APP_ID=
WX_APP_SECRET=

# 官网开发地址通配符，生产改成正式域名
VOLT_CORS_ORIGINS=http://localhost:[*],http://127.0.0.1:[*]

# 官网 /staff 店员开卡页密钥；生产必须换成强随机值
VOLT_STAFF_KEY=volt-staff-demo

# 小程序「演示支付并开卡」；本地演示改为 true，只改业务状态，不调用微信支付，生产必须 false
VOLT_DEMO_PAY=false

# 本地演示：每次后端启动执行 demo-reset-current-wechat.sql，重置当前微信会员、购卡记录与次卡余额；生产必须 false
VOLT_RESET_ON_START=false
